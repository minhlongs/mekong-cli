{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mekong.dev/contracts/tax-invoice.json",
  "title": "TT78 Vietnam Tax Invoice",
  "description": "Contract for TT78-compliant VAT invoices generated by the Mekong CLI Tax & Accounting funnel.",
  "type": "object",
  "required": ["header", "line_items"],
  "properties": {
    "header": {
      "$ref": "#/$defs/header"
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line_item" }
    },
    "notes": { "type": ["string", "null"] },
    "digital_signature": { "type": ["string", "null"], "description": "Base64 CA signature for e-invoice" }
  },
  "$defs": {
    "header": {
      "type": "object",
      "required": [
        "invoice_number", "invoice_date", "invoice_template",
        "seller_name", "seller_tax_code", "seller_address",
        "buyer_name", "buyer_address", "payment_method", "currency"
      ],
      "properties": {
        "invoice_number": { "type": "string", "pattern": "^[A-Z0-9\\-]{1,20}$" },
        "invoice_date": { "type": "string", "format": "date" },
        "invoice_template": { "type": "string", "enum": ["TT78"] },
        "seller_name": { "type": "string", "maxLength": 200 },
        "seller_tax_code": { "type": "string", "pattern": "^\\d{10,13}$" },
        "seller_address": { "type": "string", "maxLength": 500 },
        "seller_bank_account": { "type": ["string", "null"] },
        "seller_bank_name": { "type": ["string", "null"] },
        "buyer_name": { "type": "string", "maxLength": 200 },
        "buyer_tax_code": { "type": ["string", "null"], "pattern": "^\\d{10,13}$" },
        "buyer_address": { "type": "string", "maxLength": 500 },
        "buyer_bank_account": { "type": ["string", "null"] },
        "buyer_bank_name": { "type": ["string", "null"] },
        "payment_method": { "type": "string" },
        "currency": { "type": "string", "default": "VND" },
        "exchange_rate": { "type": ["string", "number"], "default": "1" }
      }
    },
    "line_item": {
      "type": "object",
      "required": ["line_number", "description", "unit", "quantity", "unit_price", "vat_category"],
      "properties": {
        "line_number": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 50 },
        "quantity": { "type": ["string", "number"] },
        "unit_price": { "type": ["string", "number"] },
        "vat_category": { "type": "string", "enum": ["standard", "reduced", "exempt", "special_consumption"] },
        "vat_rate": { "type": ["string", "number", "null"], "description": "Decimal rate e.g. 0.10" }
      }
    }
  }
}
