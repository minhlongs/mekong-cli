{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/session-init.cjs", "timeout": 3000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/dev-rules-reminder.cjs", "timeout": 1500 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/pre-tool-use-guard.cjs", "timeout": 2000 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/privacy-block.cjs", "timeout": 2000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/post-edit-simplify-reminder.cjs", "timeout": 1500 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/stop-checkpoint.cjs", "timeout": 2000 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/pre-compact-state-saver.cjs", "timeout": 3000 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node /Users/macbook/mekong-cli/.claude/hooks/session-end-telemetry.cjs", "timeout": 2000 }
        ]
      }
    ]
  }
}
