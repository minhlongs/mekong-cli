{
  "$schema": "binh-phap-escalation-v1",
  "version": "1.0.0",
  "levels": {
    "0": {
      "description": "Fully autonomous — no notification",
      "risk": "zero",
      "commands": [
        "health", "status", "daily", "sre:morning-check", "cto-dashboard",
        "cto-health", "cto-observability", "cto-selftest", "cto-workforce",
        "production-status", "factory-intelligence", "worker:health",
        "worker:log", "worker:trace", "worker:scan", "portfolio:status",
        "risk:monitor", "momentum:velocity", "context:priority",
        "context:compress", "commands-status", "model-matrix"
      ]
    },
    "1": {
      "description": "Autonomous with notification",
      "risk": "low",
      "commands": [
        "worker:code", "worker:build", "worker:test", "worker:commit",
        "worker:push", "worker:exec", "worker:backup", "dev:feature",
        "dev:bug-sprint", "dev:pr-review", "eng:sprint-execute",
        "eng:tech-debt", "backend:api-build", "backend:db-task",
        "frontend:ui-build", "frontend:responsive-fix", "qa:*",
        "data:daily-pipeline", "data:transform", "data:quality",
        "data:catalog", "sec:scan", "sec:vuln", "ml:eval", "ml:monitor",
        "ml:experiment", "ml:cost", "marketing:content-engine", "writer:*",
        "analyst:*", "growth:experiment", "accounting:daily",
        "accounting:invoice-batch", "hr:performance-cycle", "devrel:docs",
        "devrel:community", "devrel:advocate", "kb:*", "infra:topology",
        "infra:network", "obs:*"
      ]
    },
    "2": {
      "description": "Propose + human approves",
      "risk": "medium",
      "commands": [
        "ship", "release:*", "devops:*", "finance:*", "sales:deal-close",
        "marketing:campaign-run", "legal:*", "sec:incident", "sec:full-audit",
        "sec:compliance-report", "sec:access-review", "sec:secrets",
        "sec:policy", "compliance:*", "ml:deploy", "ml:retrain",
        "ml:guardrail", "pm:feature-flag", "pm:ab-test", "revops:forecast",
        "revops:comp", "hr:recruit", "hr:onboard", "people:offboard",
        "vendor:*", "treasury:*", "board:manage", "board:minutes",
        "ir:narrative", "ir:roadshow", "ir:metrics", "data:full-refresh",
        "corpdev:evaluate", "infra:region", "infra:gateway",
        "infra:optimize", "terrain:segment", "terrain:position",
        "terrain:entry", "momentum:resource", "momentum:network",
        "momentum:compound", "cdp:*"
      ]
    },
    "3": {
      "description": "Human initiates only",
      "risk": "critical",
      "commands": [
        "ipo:*", "governance:*", "board:compliance", "corpdev:integrate",
        "corpdev:scout", "venture:thesis", "studio:launch-full",
        "sec:incident-response", "esg:report", "ir:calendar",
        "terrain:defend", "terrain:retreat", "momentum:viral-loop",
        "intel:blind-spot", "intel:asymmetry"
      ]
    }
  },
  "default_level": 2,
  "override_rules": [
    { "pattern": "sec:*", "min_level": 1 },
    { "pattern": "finance:*", "min_level": 2 },
    { "pattern": "ipo:*", "min_level": 3 },
    { "pattern": "governance:*", "min_level": 3 },
    { "pattern": "corpdev:*", "min_level": 2 }
  ]
}
