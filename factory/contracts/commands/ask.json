{
  "id": "ask",
  "version": "1.0.0",
  "layer": "ops",
  "chapter": "九變 — Nine Variations",
  "display": {
    "name_en": "Ask",
    "icon": "",
    "description_en": "Answer technical and architectural questions."
  },
  "execution": {
    "agents": [
      "devops"
    ],
    "hub": "ops-hub",
    "complexity": "standard",
    "timeout_ms": 120000,
    "credit_cost": 3,
    "requires_approval": false
  },
  "input": {
    "type": "object",
    "required": [
      "goal"
    ],
    "properties": {
      "goal": {
        "type": "string",
        "description": "Natural language task description"
      },
      "services": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Target services"
      },
      "environment": {
        "type": "string",
        "enum": [
          "local",
          "staging",
          "production"
        ]
      }
    }
  },
  "output": {
    "type": "object",
    "required": [
      "answer",
      "components_analyzed",
      "mermaid_diagram",
      "recommendations"
    ],
    "properties": {
      "answer": {
        "type": "string",
        "description": "Technical or architectural response detail"
      },
      "components_analyzed": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of component names/files scanned and analyzed"
      },
      "mermaid_diagram": {
        "type": "string",
        "description": "Visual architecture layout formatted in Mermaid.js syntax"
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Actionable design guidelines or recommendations"
      }
    }
  },
  "cascade": {
    "triggers": []
  },
  "validation": {
    "output_must_contain": [],
    "min_output_length": 50,
    "max_credit_cost": 5
  }
}
