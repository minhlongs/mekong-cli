{
  "name": "crm",
  "version": "1.0.0",
  "private": true,
  "description": "Simple CRM for lead tracking",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply crm-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply crm-db"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.7.0",
    "vite": "^5.2.0",
    "wrangler": "^3.99.0"
  }
}
