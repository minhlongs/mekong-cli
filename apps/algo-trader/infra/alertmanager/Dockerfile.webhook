# Alert Webhook Server Dockerfile
# Forwards Alertmanager notifications to Twilio (SMS) and Telegram

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir twilio requests

# Copy application
COPY alert-webhook-server.py .

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5001/ || exit 1

# Expose port
EXPOSE 5001

# Run application
CMD ["python", "alert-webhook-server.py"]
