{
  "id": "compliance-audit",
  "title": "Compliance Audit Report",
  "department": "compliance",
  "sections": [
    {
      "type": "kpi-grid",
      "title": "Audit Summary",
      "dataPath": "summary",
      "columns": 3
    },
    {
      "type": "table",
      "title": "Findings",
      "dataPath": "findings",
      "config": {
        "columns": ["id", "category", "severity", "description", "owner", "due_date", "status"]
      }
    },
    {
      "type": "table",
      "title": "Control Checks",
      "dataPath": "controls",
      "config": {
        "columns": ["control_id", "name", "framework", "result", "last_tested"]
      }
    },
    {
      "type": "text",
      "title": "Auditor Recommendations",
      "dataPath": "recommendations"
    }
  ]
}
