{
  "id": "sales-pipeline",
  "title": "Sales Pipeline Report",
  "department": "sales",
  "sections": [
    {
      "type": "kpi-grid",
      "title": "Pipeline Health",
      "dataPath": "kpis",
      "columns": 4
    },
    {
      "type": "table",
      "title": "Active Deals",
      "dataPath": "deals",
      "config": {
        "columns": ["deal_name", "company", "owner", "stage", "value", "close_date", "probability"]
      }
    },
    {
      "type": "table",
      "title": "Rep Performance",
      "dataPath": "reps",
      "config": {
        "columns": ["name", "quota", "achieved", "attainment_pct", "open_pipeline"]
      }
    },
    {
      "type": "text",
      "title": "Forecast Commentary",
      "dataPath": "forecast_notes"
    }
  ]
}
