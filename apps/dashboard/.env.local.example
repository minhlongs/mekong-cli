# Mekong IDE Dashboard — Environment Variables
# Copy this file to .env.local and fill in values

# === REQUIRED for basic functionality ===
# Supabase (free tier works)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# === OPTIONAL — payment features ===
# Polar.sh (for RaaS billing)
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_AGENCY=
POLAR_PRODUCT_FRANCHISE=
POLAR_WEBHOOK_SECRET=

# === The dashboard runs WITHOUT payment env vars ===
# Only Supabase is needed. Everything else degrades gracefully.

# Stripe (legacy — Polar preferred)
# STRIPE_SECRET_KEY=sk_test_...

