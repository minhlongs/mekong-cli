# Mekong IDE Dashboard — Environment Variables
# Copy this file to .env.local and fill in values

# === REQUIRED for basic functionality ===
# Supabase (free tier works)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# === Dual-Rail RaaS Payment Gateways (VietQR + NOWPayments) ===
# Note: Legacy P-rail is permanently decommissioned (HTTP 410 Gone).
NEXT_PUBLIC_GATEWAY_API_URL=http://localhost:8000
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# === Multi-Tenant OPC Pilot A Server-Only BFF (NEVER expose as NEXT_PUBLIC_*) ===
# Minimum 32-byte HMAC-SHA256 signing secret for HttpOnly mk_opc_session cookies:
MEKONG_DASHBOARD_SESSION_SECRET=replace-with-random-32-byte-hmac-session-secret
# Optional server-only owner bootstrap token (>= 16 chars) for /api/opc/pilot-a/session:
MEKONG_DASHBOARD_OWNER_LOGIN_TOKEN=
# Server-only JSON map of tenant slug -> provisioned tenant API key (never sent to browser):
MEKONG_TENANT_KEYS_JSON={}
# Optional server-only JSON map of workspaceId -> allowed tenant slugs (leave unset unless restricting workspaces):
# MEKONG_WORKSPACE_TENANTS_JSON={"ws_default":["tenant_alpha"]}
# Internal server-to-server FastAPI Gateway base URL:
MEKONG_GATEWAY_INTERNAL_URL=http://127.0.0.1:8000

# === The dashboard runs WITHOUT payment env vars ===
# Only Supabase is needed. Payment & AI factory features degrade gracefully.
