# Mekong IDE Dashboard — Environment Variables
# Copy this file to .env.local and fill in values

# === REQUIRED for basic functionality ===
# Supabase (free tier works)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# === Dual-Rail RaaS Payment Gateways (VietQR + NOWPayments) ===
# Polar.sh is permanently decommissioned (HTTP 410 Gone).
NEXT_PUBLIC_GATEWAY_API_URL=http://localhost:8000
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# === The dashboard runs WITHOUT payment env vars ===
# Only Supabase is needed. Payment & AI factory features degrade gracefully.
