{
  "productName": "Mekong IDE",
  "version": "0.1.0",
  "identifier": "com.mekongmind.ide",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../../ide-ui/out"
  },
  "app": {
    "windows": [
      {
        "title": "Mekong IDE",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://mekong-ide-ui.pages.dev; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.mekongmind.com wss://api.mekongmind.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Mekong IDE — AI-powered development platform",
    "longDescription": "Mekong IDE is an AI-operated business and engineering platform built on OpenClaw.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": [
        "https://updates.mekongmind.com/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
