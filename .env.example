# Mekong CLI — Open-Core MIT BYOK & Payment Zero-Secret Template
MEKONG_ENV=development
MEKONG_DEBUG=1
MEKONG_LOG_LEVEL=INFO

# BYOK LLM & Messaging Providers (Bring Your Own Key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ZALO_OA_SECRET_KEY=your_zalo_oa_secret_key_here
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token_here
ZALO_OA_TIER=growth

# OPC Payload-Bound Human Approval & Signed VietQR Reconciliation
MEKONG_APPROVAL_SECRET=your_16_plus_byte_approval_hmac_secret_here
MEKONG_VIETQR_WEBHOOK_SECRET=your_vietqr_webhook_hmac_secret_here
VIETQR_WEBHOOK_SECRET=your_vietqr_webhook_hmac_secret_here

# Cloud SaaS / RaaS Payment Webhooks & Auth
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
