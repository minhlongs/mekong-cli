# =============================================================================
# Mekong CLI v5.0 — Environment Configuration
# =============================================================================

# =============================================================================
# JWT Authentication (REQUIRED for staging/production)
# =============================================================================

# Authentication environment: dev | staging | production
# In dev: JWT_SECRET auto-generated per session (not stable across restarts)
# In staging/production: JWT_SECRET MUST be set explicitly
AUTH_ENVIRONMENT=dev

# JWT signing secret — minimum 32 bytes required in staging/production
# CHANGE BEFORE PRODUCTION — generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# or:
#   openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

# LLM Provider (pick one — any OpenAI-compatible endpoint)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-yourkey
# LLM_MODEL=anthropic/claude-sonnet-4

# Or provider-specific key (auto-detect):
# OPENROUTER_API_KEY=sk-or-v1-...          # 300+ models, $5 free
# DASHSCOPE_API_KEY=sk-...                 # Qwen Coding Plan ~$10/mo (also enables Qwen Image text-to-image)
# DEEPSEEK_API_KEY=sk-...                  # DeepSeek cheap
# ANTHROPIC_API_KEY=sk-ant-...             # Claude direct
# OPENAI_API_KEY=sk-...                    # GPT direct
# GOOGLE_API_KEY=AI...                     # Gemini

# Or local LLM — Rapid-MLX (Apple Silicon, 4.2x faster than Ollama):
# LOCAL_LLM_URL=http://localhost:8001/v1
# LOCAL_LLM_MODEL=qwen3.6-35b
# Setup: brew install raullenchai/rapid-mlx/rapid-mlx
# Start: rapid-mlx serve qwen3.6-35b --port 8001

# RaaS (optional — for credit billing via Polar.sh)
# Get API key from: https://docs.polar.sh/api
# Get webhook secret from: Polar Dashboard → Settings → Webhooks
POLAR_API_KEY=sk_live_YOUR_POLAR_API_KEY
POLAR_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
POLAR_SUCCESS_URL=https://agencyos.network/success
POLAR_CANCEL_URL=https://agencyos.network/pricing

# Mekong CLI Products (create at polar.sh/mekong-cli/checkout)
POLAR_STARTER_PRODUCT_ID=prod_starter
POLAR_PRO_PRODUCT_ID=prod_pro
POLAR_ENTERPRISE_PRODUCT_ID=prod_enterprise

# =============================================================================
# Stripe Payments (alternative to Polar.sh)
# =============================================================================
# Get API keys from: https://dashboard.stripe.com/apikeys
# Get webhook secret from: Stripe Dashboard → Developers → Webhooks
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Stripe Price IDs for each tier (create these in Stripe Products/Prices)
# Env var format: STRIPE_PRICE_<TIER>=price_xxx
# Or use JSON mapping: STRIPE_PRICE_IDS='{"price_starter": "starter", ...}'
STRIPE_PRICE_STARTER=price_starter_123
STRIPE_PRICE_GROWTH=price_growth_123
STRIPE_PRICE_PRO=price_pro_123

# Stripe Checkout domain (for testing: checkout.stripe.com/test)
STRIPE_DOMAIN=checkout.stripe.com

# App base URL for redirects (default: https://mekongmind.com)
APP_BASE_URL=https://mekongmind.com

# LiteLLM Proxy (unified LLM gateway — optional)
# LITELLM_MASTER_KEY=sk-mekong-local
# LITELLM_URL=http://localhost:4000
# LITELLM_DB_URL=sqlite:///litellm.db

# =============================================================================
# CashClaw — Polymarket Prediction Trading (optional)
# =============================================================================

# Polymarket API keys (required for live trading)
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_API_KEY=your-api-key

# Local LLM for predictions (default: Ollama with DeepSeek R1)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1

# Trading database
# DATABASE_PATH=data/algo-trade.db

# Safety: ALWAYS default to paper trading
PAPER_TRADING=true
# CAPITAL_USDC=200

# Telegram monitoring (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Zalo Official Account integration (Vietnam)
# Get App ID from: https://developers.zalo.me/
# Get Access Token from: Zalo OA Console → Settings → Basic → Access Token
ZALO_APP_ID=
ZALO_OA_ACCESS_TOKEN=

# Bailian / DashScope LLM fallback
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://coding-intl.dashscope.aliyuncs.com/compatible-mode/v1

# =============================================================================
# Social Auto-Poster — Discord, dev.to, GitHub Discussions
# =============================================================================

# Discord channel webhook URL
# Create at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# dev.to API key
# Create at: https://dev.to/settings/extensions → DEV Community API Keys
DEVTO_API_KEY=

# RaaS landing URL (default: https://agencyos.network)
RAAS_URL=https://agencyos.network

# =============================================================================
# Observability — Error Tracking (optional)
# =============================================================================

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json  # json (production) or console (local dev)

# Python Backend Sentry (gateway + dashboard API)
# Get DSN from: https://sentry.io/settings/projects/<project>/keys/
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
ENVIRONMENT=development  # production | staging | development
APP_VERSION=3.3.0  # Semantic version + optional git SHA

# Cloudflare Workers Sentry (API Gateway Worker + Dashboard Worker)
# Get DSN from: https://sentry.io/settings/projects/<project>/keys/
# Set via: wrangler secret put SENTRY_DSN
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# Frontend Sentry (Next.js dashboard)
# Get DSN from: https://sentry.io/settings/projects/<project>/keys/
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional: defaults to package.json version
# NEXT_PUBLIC_SENTRY_RELEASE=3.3.0+gabc123

# Distributed tracing (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# AI OS MCP Server
# =============================================================================

# MCP server module: python -m src.core.mcp_server
# AI OS operational scripts are in mekong/adapters/:
#   mekong-ai-os.sh  — Unified entry point (source this file)
#   health-check.sh  — System health monitor (Ollama, disk, memory, thermal)
#   intent-router.cjs — Request classification by domain/complexity/mode
#   deploy-models.sh — Pull and verify tiered Ollama models
#   memory-inspector.js — Inspect ~/.system/memory.db
#   observability-report.js — Token usage, errors, traces, daemon health
#   log-error.js     — Record errors to ~/.system/errors.db
#   log-token-usage.js — Record token usage to ~/.system/tokens.db
#   trace-agent.js   — Append agent trace entries to ~/.system/trace.log

# Runtime data directory (defaults to $HOME/.system)
# AI_OS_DATA_DIR=${HOME}/.system

# =============================================================================
# Model Orchestrator settings
# =============================================================================

# Local Ollama models for tiered routing
# OLLAMA_HOST=http://localhost:11434
# MODEL_UTILITY=qwen2.5-coder:7b
# MODEL_CODING=qwen2.5-coder:14b
# MODEL_STRATEGIC=qwen3.6:35b-mlx-fast

# =============================================================================
# Operational scripts env vars
# =============================================================================

# Log level for AI OS scripts (DEBUG, INFO, WARN, ERROR)
# AI_OS_LOG_LEVEL=INFO

# Health check logging
# HEALTH_CHECK_LOG=${HOME}/.system/logs/health-check.log

# ─── VN HUB — Mekong VN Platform (1 Triệu Doanh Nghiệp 1 Người) ─────────────
# Inference backend: Rapid-MLX local (Qwen 3.6-35B + Qwen 3.5-9b)
# Setup: brew install raullenchai/rapid-mlx/rapid-mlx
# Start: rapid-mlx serve qwen3.6-35b --port 8001

# VN specialist (tiếng Việt — kế toán, thuế, marketing):
VN_LLM_BASE_URL=http://localhost:8001/v1
VN_LLM_MODEL=qwen3.6-35b

# General reasoning (phức tạp, multilingual):
VN_REASONING_MODEL=qwen3.5-9b

# Business profile (auto-loaded at startup):
# VN_BUSINESS_TYPE=shop_online   # shop_online | cafe | freelancer | dich_vu | san_xuat
# VN_CITY=hcm                    # hcm | hn | dn | other
# VN_BANK=vcb                    # vcb | tcb | acb | mb | bidv
# VN_TAX_CODE=0123456789         # Mã số thuế (optional)
