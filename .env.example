# =============================================================================
# Mekong CLI v5.0 — Environment Configuration
# =============================================================================

# =============================================================================
# JWT Authentication (REQUIRED for staging/production)
# =============================================================================

# Authentication environment: dev | staging | production
# In dev: JWT_SECRET auto-generated per session (not stable across restarts)
# In staging/production: JWT_SECRET MUST be set explicitly
AUTH_ENVIRONMENT=dev

# JWT signing secret — minimum 32 bytes required in staging/production
# CHANGE BEFORE PRODUCTION — generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# or:
#   openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

# LLM Provider (pick one — any OpenAI-compatible endpoint)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-yourkey
# LLM_MODEL=anthropic/claude-sonnet-4

# Or provider-specific key (auto-detect):
# OPENROUTER_API_KEY=sk-or-v1-...          # 300+ models, $5 free
# DASHSCOPE_API_KEY=sk-...                 # Qwen Coding Plan ~$10/mo (also enables Qwen Image text-to-image)
# DEEPSEEK_API_KEY=sk-...                  # DeepSeek cheap
# ANTHROPIC_API_KEY=sk-ant-...             # Claude direct
# OPENAI_API_KEY=sk-...                    # GPT direct
# GOOGLE_API_KEY=AI...                     # Gemini

# Or local LLM — MLX (Apple Silicon):
# LOCAL_LLM_URL=http://localhost:11435/v1
# LOCAL_LLM_MODEL=mlx-community/DeepSeek-R1-Distill-Qwen-32B-4bit
# Setup: pip install mlx-lm && python -m mlx_lm.server --model mlx-community/DeepSeek-R1-Distill-Qwen-32B-4bit --port 11435

# RaaS (optional — for credit billing via Polar.sh)
# Get API key from: https://docs.polar.sh/api
# Get webhook secret from: Polar Dashboard → Settings → Webhooks
POLAR_API_KEY=sk_live_YOUR_POLAR_API_KEY
POLAR_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
POLAR_SUCCESS_URL=https://agencyos.network/success
POLAR_CANCEL_URL=https://agencyos.network/pricing

# Mekong CLI Products (create at polar.sh/mekong-cli/checkout)
POLAR_STARTER_PRODUCT_ID=prod_starter
POLAR_PRO_PRODUCT_ID=prod_pro
POLAR_ENTERPRISE_PRODUCT_ID=prod_enterprise

# LiteLLM Proxy (unified LLM gateway — optional)
# LITELLM_MASTER_KEY=sk-mekong-local
# LITELLM_URL=http://localhost:4000
# LITELLM_DB_URL=sqlite:///litellm.db

# =============================================================================
# CashClaw — Polymarket Prediction Trading (optional)
# =============================================================================

# Polymarket API keys (required for live trading)
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_API_KEY=your-api-key

# Local LLM for predictions (default: Ollama with DeepSeek R1)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=deepseek-r1

# Trading database
# DATABASE_PATH=data/algo-trade.db

# Safety: ALWAYS default to paper trading
PAPER_TRADING=true
# CAPITAL_USDC=200

# Telegram monitoring (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Bailian / DashScope LLM fallback
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://coding-intl.dashscope.aliyuncs.com/compatible-mode/v1

# =============================================================================
# Social Auto-Poster — Discord, dev.to, GitHub Discussions
# =============================================================================

# Discord channel webhook URL
# Create at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# dev.to API key
# Create at: https://dev.to/settings/extensions → DEV Community API Keys
DEVTO_API_KEY=

# RaaS landing URL (default: https://agencyos.network)
RAAS_URL=https://agencyos.network

# =============================================================================
# Observability — Error Tracking (optional)
# =============================================================================

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json  # json (production) or console (local dev)

# Error tracking (optional)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Distributed tracing (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── VN HUB — Mekong VN Platform (1 Triệu Doanh Nghiệp 1 Người) ─────────────
# Inference backend: MLX local (PhoGPT-4B + Qwen3-14B)
# Setup: bash scripts/setup-mlx.sh
# Start: bash scripts/start-mlx-server.sh [phogpt-4b|qwen3-14b-q4|auto]

# VN specialist (tiếng Việt — kế toán, thuế, marketing):
VN_LLM_BASE_URL=http://localhost:11434/v1
VN_LLM_MODEL=qwen3-8b

# General reasoning (phức tạp, multilingual):
VN_REASONING_MODEL=qwen3-14b-q4

# Business profile (auto-loaded at startup):
# VN_BUSINESS_TYPE=shop_online   # shop_online | cafe | freelancer | dich_vu | san_xuat
# VN_CITY=hcm                    # hcm | hn | dn | other
# VN_BANK=vcb                    # vcb | tcb | acb | mb | bidv
# VN_TAX_CODE=0123456789         # Mã số thuế (optional)
