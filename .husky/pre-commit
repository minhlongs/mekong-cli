#!/bin/sh
# 🏯 PRE-COMMIT HOOK - Binh Pháp CI Protection Layer 1

echo "🔍 Pre-commit: Running quick checks..."

# Python lint (if ruff available) — only staged .py files
if command -v ruff &> /dev/null; then
    STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- "*.py" 2>/dev/null)
    if [ -n "$STAGED_PY" ]; then
        echo "   → Ruff lint (staged files only)..."
        echo "$STAGED_PY" | grep -v "apps/.*/\.claude/" | grep -v "^\.claude/skills/" | grep -v "^\.claude-skills/" | grep -v "^\.agencyos/" | grep -v "^\.agent/" | grep -v "^mekong/skills/" | xargs ruff check --fix --quiet || {
            echo "❌ Ruff lint failed. Fix errors before committing."
            exit 1
        }
    fi
fi

# TypeScript check — warning only (dashboard has pre-existing errors)
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM -- "apps/dashboard/**/*.ts" "apps/dashboard/**/*.tsx" 2>/dev/null)
if [ -n "$STAGED_TS" ] && [ -f "apps/dashboard/tsconfig.json" ]; then
    echo "   → TypeScript check (warning only)..."
    cd apps/dashboard
    TS_ERRORS=$(pnpm exec tsc --noEmit --skipLibCheck 2>&1 | grep "error TS" | wc -l)
    if [ "$TS_ERRORS" -gt 0 ]; then
        echo "   ⚠️  $TS_ERRORS TypeScript errors in dashboard (pre-existing, non-blocking)"
    fi
    cd ../..
fi

# Critical payment tests
if [ -f "backend/tests/unit/test_payment_service.py" ]; then
    echo "   → Critical payment tests..."
    if [ -f "backend/.venv/bin/pytest" ]; then
        PYTEST_CMD="backend/.venv/bin/pytest"
    elif command -v pytest &> /dev/null; then
        PYTEST_CMD="pytest"
    else
        PYTEST_CMD=""
    fi
    if [ -n "$PYTEST_CMD" ]; then
        export PYTHONPATH="$PYTHONPATH:$(pwd)"
        $PYTEST_CMD backend/tests/unit/test_payment_service.py::TestCreateCheckoutSession \
               -x --tb=short --no-cov -q 2>&1 | tail -5
        if [ "${PIPESTATUS[0]}" -ne 0 ]; then
            if $PYTEST_CMD backend/tests/unit/test_payment_service.py::TestCreateCheckoutSession \
                   -x --tb=short --no-cov -q 2>&1 | grep -q "ModuleNotFoundError\|ImportError"; then
                echo "⚠️  Payment tests skipped (missing dependencies)"
            else
                echo "❌ Critical payment tests failed."
                exit 1
            fi
        fi
    fi
fi

# ClaudeKit Layer Contract guard (added 2026-04-29)
if [ -x scripts/audit-architecture.sh ]; then
    echo "   → Layer contract audit..."
    if ! bash scripts/audit-architecture.sh > /dev/null 2>&1; then
        echo "⚠️  Layer contract drift detected. Run: bash scripts/audit-architecture.sh"
        # Warning only — non-blocking. Make blocking by replacing with: exit 1
    fi
fi

echo "✅ Pre-commit passed"
