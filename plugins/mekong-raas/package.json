{
  "name": "@mekongcli/raas-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "RaaS tenant metering plugin for OpenClaw — credit validation, billing ledger, 402 enforcement",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsup src/index.ts --watch"
  },
  "keywords": [
    "mekong",
    "openclaw",
    "raas",
    "plugin",
    "metering",
    "billing"
  ],
  "author": "Mekong CLI <hello@mekong.dev>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
