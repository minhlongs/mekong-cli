{
  "name": "@mekong/mekong-tasks",
  "version": "1.0.0",
  "private": false,
  "description": "Mekong recipe → OpenClaw /tasks adapter — converts DAG recipes into background task board entries",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "mekong",
    "openclaw",
    "tasks",
    "recipes",
    "dag",
    "workflow"
  ],
  "license": "MIT"
}
