{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "types": ["bun"]
  },
  "include": ["src/**/*"]
}
