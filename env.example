# Mekong CLI — Environment Configuration
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# LLM Providers (public contributors add their own keys)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=AIza...

# Database (local dev)
DATABASE_URL=postgresql://localhost:5432/mekong
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
NEO4J_URL=bolt://localhost:7687

# Application
ENV=development
LOG_LEVEL=INFO
PORT=8000

# Observability (optional — add your own)
SENTRY_DSN=
POSTHOG_API_KEY=