{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "noEmit": true
  },
  "include": ["tools/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "packages/**", "mekong/**", "src/**", "apps/**"]
}
