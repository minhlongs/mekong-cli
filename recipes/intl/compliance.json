{
  "id": "intl-compliance",
  "name": "Country Compliance",
  "description": "Country compliance",
  "trigger": "/intl:compliance",
  "output_dir": "reports/intl/compliance",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "identify", "name": "Identify Regulations", "mode": "sequential", "commands": [{"id": "identify-regs", "args": "--country"}], "depends_on": []},
      {"id": "gap", "name": "Gap Analysis", "mode": "sequential", "commands": [{"id": "gap-analysis", "args": "--current-posture"}], "depends_on": ["identify"]},
      {"id": "remediate", "name": "Remediation Plan", "mode": "sequential", "commands": [{"id": "remediation-plan", "args": "--priority-sort"}], "depends_on": ["gap"]}
    ]
  }
}
