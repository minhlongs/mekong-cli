{
  "id": "intl-market-assess",
  "name": "Market Assessment",
  "description": "Market entry analysis",
  "trigger": "/intl:market-assess",
  "output_dir": "reports/intl/market-assess",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "macro", "name": "Macro Analysis", "mode": "sequential", "commands": [{"id": "macro-analysis", "args": "--gdp,population,digital"}], "depends_on": []},
      {"id": "regulatory", "name": "Regulatory Scan", "mode": "sequential", "commands": [{"id": "regulatory-scan", "args": "--data-privacy,tax"}], "depends_on": ["macro"]},
      {"id": "competitive", "name": "Competitive Landscape", "mode": "sequential", "commands": [{"id": "competitive-landscape", "args": "--local-players"}], "depends_on": ["regulatory"]},
      {"id": "decision", "name": "Go/No-Go", "mode": "sequential", "commands": [{"id": "go-nogo-decision", "args": "--scorecard"}], "depends_on": ["competitive"]}
    ]
  }
}
