{
  "id": "intl-localize",
  "name": "Localization",
  "description": "i18n pipeline",
  "trigger": "/intl:localize",
  "output_dir": "reports/intl/localize",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "extract", "name": "Extract Strings", "mode": "sequential", "commands": [{"id": "extract-strings", "args": "--i18n-keys"}], "depends_on": []},
      {"id": "translate", "name": "Translate", "mode": "sequential", "commands": [{"id": "translate-strings", "args": "--machine+human"}], "depends_on": ["extract"]},
      {"id": "review", "name": "Review", "mode": "sequential", "commands": [{"id": "review-translations", "args": "--native-speaker"}], "depends_on": ["translate"]},
      {"id": "deploy", "name": "Deploy", "mode": "sequential", "commands": [{"id": "deploy-translations", "args": "--cdn"}], "depends_on": ["review"]}
    ]
  }
}
