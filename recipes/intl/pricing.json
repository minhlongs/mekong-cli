{
  "id": "intl-pricing",
  "name": "Geo Pricing",
  "description": "Geo pricing",
  "trigger": "/intl:pricing",
  "output_dir": "reports/intl/pricing",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "benchmark", "name": "Benchmark Market", "mode": "sequential", "commands": [{"id": "benchmark-market", "args": "--competitors"}], "depends_on": []},
      {"id": "ppp", "name": "Calculate PPP", "mode": "sequential", "commands": [{"id": "calculate-ppp", "args": "--world-bank-data"}], "depends_on": ["benchmark"]},
      {"id": "tiers", "name": "Set Tiers", "mode": "sequential", "commands": [{"id": "set-pricing-tiers", "args": "--by-country"}], "depends_on": ["ppp"]}
    ]
  }
}
