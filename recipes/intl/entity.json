{
  "id": "intl-entity",
  "name": "International Entity",
  "description": "Entity setup",
  "trigger": "/intl:entity",
  "output_dir": "reports/intl/entity",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {"id": "structure", "name": "Select Structure", "mode": "sequential", "commands": [{"id": "select-structure", "args": "--subsidiary-vs-branch"}], "depends_on": []},
      {"id": "register", "name": "Register Entity", "mode": "sequential", "commands": [{"id": "register-entity", "args": "--jurisdiction"}], "depends_on": ["structure"]},
      {"id": "banking", "name": "Setup Banking", "mode": "sequential", "commands": [{"id": "setup-banking", "args": "--multi-currency"}], "depends_on": ["register"]},
      {"id": "tax", "name": "Tax Plan", "mode": "sequential", "commands": [{"id": "tax-plan", "args": "--transfer-pricing"}], "depends_on": ["banking"]}
    ]
  }
}
