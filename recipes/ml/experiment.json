{
  "id": "ml-experiment",
  "name": "ML Experiment",
  "description": "Experiment tracking",
  "trigger": "/ml:experiment",
  "output_dir": "reports/ml/experiment",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "setup", "name": "Setup Tracking", "mode": "sequential", "commands": [{"id": "setup-tracking", "args": "--mlflow"}], "depends_on": []},
      {"id": "log", "name": "Log Run", "mode": "sequential", "commands": [{"id": "log-run", "args": "--metrics,params"}], "depends_on": ["setup"]},
      {"id": "compare", "name": "Compare Models", "mode": "sequential", "commands": [{"id": "compare-models", "args": "--leaderboard"}], "depends_on": ["log"]}
    ]
  }
}
