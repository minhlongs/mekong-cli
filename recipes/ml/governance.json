{
  "id": "ml-governance",
  "name": "AI Governance",
  "description": "AI governance pipeline",
  "trigger": "/ml:governance",
  "output_dir": "reports/ml/governance",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "card", "name": "Generate Model Card", "mode": "sequential", "commands": [{"id": "generate-model-card", "args": "--template"}], "depends_on": []},
      {"id": "audit", "name": "Audit Trail", "mode": "sequential", "commands": [{"id": "audit-trail", "args": "--immutable-log"}], "depends_on": ["card"]},
      {"id": "compliance", "name": "Compliance Check", "mode": "sequential", "commands": [{"id": "ai-compliance-check", "args": "--eu-ai-act"}], "depends_on": ["audit"]}
    ]
  }
}
