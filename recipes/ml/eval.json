{
  "id": "ml-eval",
  "name": "Prompt Evaluation",
  "description": "Eval suite pipeline",
  "trigger": "/ml:eval",
  "output_dir": "reports/ml/eval",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "load", "name": "Load Suite", "mode": "sequential", "commands": [{"id": "load-suite", "args": "--semantic"}], "depends_on": []},
      {"id": "run", "name": "Run Evals", "mode": "sequential", "commands": [{"id": "run-evals", "args": "--parallel"}], "depends_on": ["load"]},
      {"id": "compare", "name": "Compare Baseline", "mode": "sequential", "commands": [{"id": "compare-baseline", "args": "--regression-check"}], "depends_on": ["run"]},
      {"id": "report", "name": "Eval Report", "mode": "sequential", "commands": [{"id": "eval-report", "args": "--pass-fail"}], "depends_on": ["compare"]}
    ]
  }
}
