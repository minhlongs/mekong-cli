{
  "id": "ml-cost",
  "name": "Inference Cost",
  "description": "Cost tracking pipeline",
  "trigger": "/ml:cost",
  "output_dir": "reports/ml/cost",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {"id": "collect", "name": "Collect Usage", "mode": "sequential", "commands": [{"id": "collect-usage", "args": "--all-models"}], "depends_on": []},
      {"id": "allocate", "name": "Allocate Costs", "mode": "sequential", "commands": [{"id": "allocate-costs", "args": "--per-customer"}], "depends_on": ["collect"]},
      {"id": "alerts", "name": "Set Alerts", "mode": "sequential", "commands": [{"id": "set-cost-alerts", "args": "--budget-threshold"}], "depends_on": ["allocate"]}
    ]
  }
}
