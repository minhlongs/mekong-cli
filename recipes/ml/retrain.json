{
  "id": "ml-retrain",
  "name": "Auto Retrain",
  "description": "Retrain pipeline",
  "trigger": "/ml:retrain",
  "output_dir": "reports/ml/retrain",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {"id": "trigger", "name": "Check Triggers", "mode": "sequential", "commands": [{"id": "check-triggers", "args": "--drift-threshold"}], "depends_on": []},
      {"id": "prepare", "name": "Prepare Data", "mode": "sequential", "commands": [{"id": "prepare-data", "args": "--latest"}], "depends_on": ["trigger"]},
      {"id": "retrain", "name": "Retrain", "mode": "sequential", "commands": [{"id": "retrain-model", "args": "--fine-tune"}], "depends_on": ["prepare"]},
      {"id": "validate", "name": "Validate", "mode": "sequential", "commands": [{"id": "validate-model", "args": "--eval-suite"}], "depends_on": ["retrain"]}
    ]
  }
}
