{
  "id": "ml-deploy",
  "name": "Model Deploy",
  "description": "Model deployment pipeline",
  "trigger": "/ml:deploy",
  "output_dir": "reports/ml/deploy",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {"id": "package", "name": "Package Model", "mode": "sequential", "commands": [{"id": "package-model", "args": "--onnx"}], "depends_on": []},
      {"id": "canary", "name": "Deploy Canary", "mode": "sequential", "commands": [{"id": "deploy-canary", "args": "--traffic 5pct"}], "depends_on": ["package"]},
      {"id": "monitor", "name": "Monitor Metrics", "mode": "sequential", "commands": [{"id": "monitor-canary", "args": "--latency,accuracy"}], "depends_on": ["canary"]},
      {"id": "promote", "name": "Promote", "mode": "sequential", "commands": [{"id": "promote-model", "args": "--full-traffic"}], "depends_on": ["monitor"]}
    ]
  }
}
