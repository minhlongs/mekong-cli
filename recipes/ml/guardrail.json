{
  "id": "ml-guardrail",
  "name": "AI Guardrails",
  "description": "Guardrail pipeline",
  "trigger": "/ml:guardrail",
  "output_dir": "reports/ml/guardrail",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "define", "name": "Define Rules", "mode": "sequential", "commands": [{"id": "define-rules", "args": "--safety-taxonomy"}], "depends_on": []},
      {"id": "test", "name": "Test Guardrails", "mode": "sequential", "commands": [{"id": "test-guardrails", "args": "--adversarial"}], "depends_on": ["define"]},
      {"id": "deploy", "name": "Deploy Filters", "mode": "sequential", "commands": [{"id": "deploy-filters", "args": "--production"}], "depends_on": ["test"]}
    ]
  }
}
