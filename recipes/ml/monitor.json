{
  "id": "ml-monitor",
  "name": "Model Monitor",
  "description": "Model monitoring pipeline",
  "trigger": "/ml:monitor",
  "output_dir": "reports/ml/monitor",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "checks", "name": "Monitoring Checks", "mode": "parallel", "commands": [{"id": "drift-check", "args": "--statistical"}, {"id": "latency-check", "args": "--p99"}, {"id": "hallucination-check", "args": "--semantic"}, {"id": "cost-check", "args": "--per-request"}], "depends_on": []},
      {"id": "alert", "name": "Alert Report", "mode": "sequential", "commands": [{"id": "monitoring-alert", "args": "--slack,pager"}], "depends_on": ["checks"]}
    ]
  }
}
