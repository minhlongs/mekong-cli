{
  "id": "momentum-network",
  "name": "Network Effects",
  "description": "Network effect analysis",
  "trigger": "/momentum:network",
  "output_dir": "reports/momentum/network",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "graph", "name": "Graph Analysis", "mode": "sequential", "commands": [{"id": "graph-analysis", "args": "--nodes,edges"}], "depends_on": []},
      {"id": "curve", "name": "Value Curve", "mode": "sequential", "commands": [{"id": "value-curve", "args": "--metcalfe"}], "depends_on": ["graph"]},
      {"id": "score", "name": "Defensibility Score", "mode": "sequential", "commands": [{"id": "defensibility-score", "args": "--moat-rating"}], "depends_on": ["curve"]}] }
}
