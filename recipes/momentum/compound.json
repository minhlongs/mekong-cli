{
  "id": "momentum-compound",
  "name": "Compound Growth",
  "description": "Compound growth calc",
  "trigger": "/momentum:compound",
  "output_dir": "reports/momentum/compound",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": { "groups": [
      {"id": "inputs", "name": "Retention + Expansion", "mode": "parallel", "commands": [{"id": "retention-curve", "args": "--cohort"}, {"id": "expansion-analysis", "args": "--upsell"}], "depends_on": []},
      {"id": "model", "name": "Compound Model", "mode": "sequential", "commands": [{"id": "compound-model", "args": "--5yr-projection"}], "depends_on": ["inputs"]}] }
}
