{
  "id": "momentum-resource",
  "name": "Resource Allocation",
  "description": "Momentum-based allocation",
  "trigger": "/momentum:resource",
  "output_dir": "reports/momentum/resource",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "score", "name": "Score Projects", "mode": "sequential", "commands": [{"id": "score-projects", "args": "--momentum-metrics"}], "depends_on": []},
      {"id": "rank", "name": "Rank by Momentum", "mode": "sequential", "commands": [{"id": "rank-by-momentum", "args": "--cutoff-quartile"}], "depends_on": ["score"]},
      {"id": "allocate", "name": "Allocate Budget", "mode": "sequential", "commands": [{"id": "allocate-budget", "args": "--winner-biased"}], "depends_on": ["rank"]}] }
}
