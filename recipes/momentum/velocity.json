{
  "id": "momentum-velocity",
  "name": "Scaling Velocity",
  "description": "Velocity tracking",
  "trigger": "/momentum:velocity",
  "output_dir": "reports/momentum/velocity",
  "estimated_credits": 3,
  "estimated_minutes": 8,
  "dag": { "groups": [
      {"id": "pull", "name": "Pull Metrics", "mode": "sequential", "commands": [{"id": "pull-metrics", "args": "--mrr,users,features"}], "depends_on": []},
      {"id": "calc", "name": "Calculate Velocity", "mode": "sequential", "commands": [{"id": "calculate-velocity", "args": "--trend"}], "depends_on": ["pull"]},
      {"id": "report", "name": "Trend Report", "mode": "sequential", "commands": [{"id": "velocity-report", "args": "--sparklines"}], "depends_on": ["calc"]}] }
}
