{
  "id": "qa-plan",
  "name": "Test Plan",
  "description": "Test plan generation from requirements",
  "trigger": "/qa:plan",
  "output_dir": "reports/qa/plan",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "analyze",
        "name": "Analyze Requirements",
        "mode": "sequential",
        "commands": [{ "id": "analyze-requirements", "args": "--source prd" }],
        "depends_on": []
      }, 
      {
        "id": "generate",
        "name": "Generate Test Cases",
        "mode": "sequential",
        "commands": [{ "id": "generate-test-cases", "args": "--coverage full" }],
        "depends_on": ["analyze"]
      }, 
      {
        "id": "review",
        "name": "Review Plan",
        "mode": "sequential",
        "commands": [{ "id": "review-plan", "args": "--checklist" }],
        "depends_on": ["generate"]
      }]
  }
}
