{
  "id": "qa-perf",
  "name": "Performance Testing",
  "description": "Performance and load testing pipeline",
  "trigger": "/qa:perf",
  "output_dir": "reports/qa/perf",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {
        "id": "setup",
        "name": "Configure + Warm Up",
        "mode": "parallel",
        "commands": [{ "id": "configure-k6", "args": "--scenario load" }, { "id": "warm-up", "args": "--target staging" }],
        "depends_on": []
      }, 
      {
        "id": "execute",
        "name": "Execute Load Test",
        "mode": "sequential",
        "commands": [{ "id": "execute-load-test", "args": "--vus 100 --duration 5m" }],
        "depends_on": ["setup"]
      }, 
      {
        "id": "analyze",
        "name": "Analyze Results",
        "mode": "sequential",
        "commands": [{ "id": "analyze-perf", "args": "--thresholds p95,p99" }],
        "depends_on": ["execute"]
      }]
  }
}
