{
  "id": "qa-regression",
  "name": "Regression Tests",
  "description": "Regression test suite management",
  "trigger": "/qa:regression",
  "output_dir": "reports/qa/regression",
  "estimated_credits": 2,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {
        "id": "select",
        "name": "Select Suite",
        "mode": "sequential",
        "commands": [{ "id": "select-suite", "args": "--scope affected" }],
        "depends_on": []
      }, 
      {
        "id": "run",
        "name": "Run Regression",
        "mode": "sequential",
        "commands": [{ "id": "run-regression", "args": "--parallel" }],
        "depends_on": ["select"]
      }, 
      {
        "id": "diff",
        "name": "Diff Report",
        "mode": "sequential",
        "commands": [{ "id": "diff-report", "args": "--baseline main" }],
        "depends_on": ["run"]
      }]
  }
}
