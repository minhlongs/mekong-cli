{
  "id": "qa-e2e",
  "name": "E2E Tests",
  "description": "End-to-end test execution pipeline",
  "trigger": "/qa:e2e",
  "output_dir": "reports/qa/e2e",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {
        "id": "run",
        "name": "Run Playwright Suite",
        "mode": "sequential",
        "commands": [{ "id": "run-playwright", "args": "--project all" }],
        "depends_on": []
      }, 
      {
        "id": "collect",
        "name": "Collect Results",
        "mode": "sequential",
        "commands": [{ "id": "collect-results", "args": "--screenshots" }],
        "depends_on": [\"run\"]
      }, 
      {
        "id": "report",
        "name": "Generate Report",
        "mode": "sequential",
        "commands": [{ "id": "e2e-report", "args": "--html" }],
        "depends_on": [\"collect\"]
      }]
  }
}
