{
  "id": "qa-accessibility",
  "name": "Accessibility Audit",
  "description": "WCAG AA accessibility audit pipeline",
  "trigger": "/qa:accessibility",
  "output_dir": "reports/qa/accessibility",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "scan",
        "name": "Axe + Lighthouse Scans",
        "mode": "parallel",
        "commands": [{ "id": "axe-scan", "args": "--wcag-aa" }, { "id": "lighthouse-audit", "args": "--a11y" }],
        "depends_on": []
      }, 
      {
        "id": "report",
        "name": "Remediation Report",
        "mode": "sequential",
        "commands": [{ "id": "accessibility-report", "args": "--prioritize" }],
        "depends_on": [\"scan\"]
      }]
  }
}
