{
  "id": "qa-chaos",
  "name": "Chaos Engineering",
  "description": "Chaos engineering pipeline",
  "trigger": "/qa:chaos",
  "output_dir": "reports/qa/chaos",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {
        "id": "define",
        "name": "Define Experiments",
        "mode": "sequential",
        "commands": [{ "id": "define-experiments", "args": "--blast-radius limited" }],
        "depends_on": []
      }, 
      {
        "id": "inject",
        "name": "Inject Faults",
        "mode": "sequential",
        "commands": [{ "id": "inject-faults", "args": "--type network,cpu,memory" }],
        "depends_on": [\"define\"]
      }, 
      {
        "id": "observe",
        "name": "Observe Recovery",
        "mode": "sequential",
        "commands": [{ "id": "observe-recovery", "args": "--timeout 60s" }],
        "depends_on": [\"inject\"]
      }, 
      {
        "id": "report",
        "name": "Chaos Report",
        "mode": "sequential",
        "commands": [{ "id": "chaos-report", "args": "--recommendations" }],
        "depends_on": [\"observe\"]
      }]
  }
}
