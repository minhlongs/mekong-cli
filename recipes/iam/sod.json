{
  "id": "iam-sod",
  "name": "SoD Detection",
  "description": "Segregation of duties violation detection",
  "trigger": "/iam:sod",
  "output_dir": "reports/iam/sod",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {
        "id": "detect",
        "name": "Detect SoD Violations",
        "mode": "sequential",
        "commands": [{ "id": "sod-analyze", "args": "--matrix sod-rules.json --report" }],
        "depends_on": []
      }]
  }
}
