{
  "id": "iam-review",
  "name": "Access Recertification",
  "description": "Quarterly access recertification pipeline",
  "trigger": "/iam:review",
  "output_dir": "reports/iam/review",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {
        "id": "extract",
        "name": "Extract Entitlements + Managers",
        "mode": "parallel",
        "commands": [{ "id": "extract-entitlements", "args": "--all-systems" }, { "id": "collect-managers", "args": "--org-chart" }],
        "depends_on": []
      }, 
      {
        "id": "certify",
        "name": "Run Certification",
        "mode": "sequential",
        "commands": [{ "id": "certify-access", "args": "--deadline 14d" }],
        "depends_on": [\"extract\"]
      }, 
      {
        "id": "remediate",
        "name": "Remediate Exceptions",
        "mode": "sequential",
        "commands": [{ "id": "remediate-exceptions", "args": "--auto-revoke" }],
        "depends_on": [\"certify\"]
      }]
  }
}
