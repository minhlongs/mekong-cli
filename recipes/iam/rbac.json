{
  "id": "iam-rbac",
  "name": "RBAC Management",
  "description": "RBAC matrix management pipeline",
  "trigger": "/iam:rbac",
  "output_dir": "reports/iam/rbac",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "extract",
        "name": "Extract Roles",
        "mode": "sequential",
        "commands": [{ "id": "extract-roles", "args": "--all-apps" }],
        "depends_on": []
      }, 
      {
        "id": "analyze",
        "name": "Analyze Coverage",
        "mode": "sequential",
        "commands": [{ "id": "analyze-coverage", "args": "--gap-detect" }],
        "depends_on": [\"extract\"]
      }, 
      {
        "id": "update",
        "name": "Update Matrix",
        "mode": "sequential",
        "commands": [{ "id": "update-matrix", "args": "--publish" }],
        "depends_on": [\"analyze\"]
      }]
  }
}
