{
  "id": "iam-pam",
  "name": "Privileged Access",
  "description": "Privileged access management pipeline",
  "trigger": "/iam:pam",
  "output_dir": "reports/iam/pam",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "scan",
        "name": "Scan Privileged Accounts",
        "mode": "sequential",
        "commands": [{ "id": "scan-privileged", "args": "--all" }],
        "depends_on": []
      }, 
      {
        "id": "enforce",
        "name": "Enforce JIT Policies",
        "mode": "sequential",
        "commands": [{ "id": "enforce-jit", "args": "--max-duration 4h" }],
        "depends_on": ["scan"]
      }, 
      {
        "id": "audit",
        "name": "Audit Log",
        "mode": "sequential",
        "commands": [{ "id": "audit-pam-log", "args": "--export" }],
        "depends_on": ["enforce"]
      }]
  }
}
