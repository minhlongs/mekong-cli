{
  "id": "iam-provision",
  "name": "User Provisioning",
  "description": "Automated user provisioning pipeline",
  "trigger": "/iam:provision",
  "output_dir": "reports/iam/provision",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {
        "id": "setup",
        "name": "Create Account + Assign Roles",
        "mode": "parallel",
        "commands": [{ "id": "create-account", "args": "--scim" }, { "id": "assign-roles", "args": "--rbac-matrix" }],
        "depends_on": []
      }, 
      {
        "id": "verify",
        "name": "Verify Access",
        "mode": "sequential",
        "commands": [{ "id": "verify-access", "args": "--test-login" }],
        "depends_on": ["setup"]
      }]
  }
}
