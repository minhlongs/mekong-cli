{
  "id": "iam-deprovision",
  "name": "Access Revocation",
  "description": "Immediate access revocation pipeline",
  "trigger": "/iam:deprovision",
  "output_dir": "reports/iam/deprovision",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {
        "id": "revoke",
        "name": "Revoke All Access",
        "mode": "sequential",
        "commands": [{ "id": "revoke-all-access", "args": "--immediate" }],
        "depends_on": []
      }, 
      {
        "id": "archive",
        "name": "Archive Data",
        "mode": "sequential",
        "commands": [{ "id": "archive-user-data", "args": "--retention 90d" }],
        "depends_on": ["revoke"]
      }, 
      {
        "id": "evidence",
        "name": "Generate Evidence",
        "mode": "sequential",
        "commands": [{ "id": "generate-evidence", "args": "--sox-compliant" }],
        "depends_on": ["archive"]
      }]
  }
}
