{
  "id": "risk-fraud-detect",
  "name": "Fraud Detection",
  "description": "Anti-fraud monitoring",
  "trigger": "/risk:fraud-detect",
  "output_dir": "reports/risk/fraud-detect",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {
        "id": "detect",
        "name": "Detect Fraud",
        "mode": "sequential",
        "commands": [{ "id": "fraud-detect", "args": "--sod-violations --anomaly-threshold 3sigma" }],
        "depends_on": []
      }]
  }
}
