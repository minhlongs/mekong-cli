{
  "id": "risk-report",
  "name": "Risk Report",
  "description": "Board-ready risk reports pipeline",
  "trigger": "/risk:report",
  "output_dir": "reports/risk/report",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {
        "id": "heatmap",
        "name": "Generate Heat Map",
        "mode": "sequential",
        "commands": [{ "id": "risk-heat-map", "args": "--current-quarter" }],
        "depends_on": []
      }, 
      {
        "id": "deficiency",
        "name": "Track Deficiencies",
        "mode": "sequential",
        "commands": [{ "id": "deficiency-track", "args": "--open-items" }],
        "depends_on": ["heatmap"]
      }, 
      {
        "id": "status",
        "name": "Remediation Status",
        "mode": "sequential",
        "commands": [{ "id": "remediation-status", "args": "--board-format" }],
        "depends_on": ["deficiency"]
      }]
  }
}
