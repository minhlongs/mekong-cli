{
  "id": "risk-assess",
  "name": "Risk Assessment",
  "description": "Enterprise risk library and scoring pipeline",
  "trigger": "/risk:assess",
  "output_dir": "reports/risk/assess",
  "estimated_credits": 5,
  "estimated_minutes": 20,
  "dag": {
    "groups": [
      {
        "id": "identify",
        "name": "Catalog + Identify",
        "mode": "parallel",
        "commands": [{ "id": "catalog-processes", "args": "--all-departments" }, { "id": "identify-risks", "args": "--taxonomy" }],
        "depends_on": []
      }, 
      {
        "id": "map",
        "name": "Map Controls",
        "mode": "sequential",
        "commands": [{ "id": "map-controls", "args": "--control-matrix" }],
        "depends_on": ["identify"]
      }, 
      {
        "id": "score",
        "name": "Score Residual Risk",
        "mode": "sequential",
        "commands": [{ "id": "score-residual", "args": "--heat-map" }],
        "depends_on": ["map"]
      }]
  }
}
