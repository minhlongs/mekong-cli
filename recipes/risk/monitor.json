{
  "id": "risk-monitor",
  "name": "Controls Monitoring",
  "description": "Continuous controls monitoring",
  "trigger": "/risk:monitor",
  "output_dir": "reports/risk/monitor",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {
        "id": "monitor",
        "name": "Monitor Controls",
        "mode": "sequential",
        "commands": [{ "id": "controls-monitor", "args": "--realtime --alert-on-failure" }],
        "depends_on": []
      }]
  }
}
