{
  "id": "data-metric",
  "name": "Semantic Layer",
  "description": "Semantic layer management",
  "trigger": "/data:metric",
  "output_dir": "reports/data/metric",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      { "id": "define", "name": "Define Metrics", "mode": "sequential", "commands": [{ "id": "define-metrics", "args": "--yaml" }], "depends_on": [] }, 
      { "id": "validate", "name": "Validate Calculations", "mode": "sequential", "commands": [{ "id": "validate-calculations", "args": "--test-against-source" }], "depends_on": ["define"] }, 
      { "id": "publish", "name": "Publish Layer", "mode": "sequential", "commands": [{ "id": "publish-layer", "args": "--api-expose" }], "depends_on": ["validate"] }]
  }
}
