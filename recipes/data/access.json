{
  "id": "data-access",
  "name": "Data Access Control",
  "description": "Data access control pipeline",
  "trigger": "/data:access",
  "output_dir": "reports/data/access",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      { "id": "scan", "name": "Scan Policies", "mode": "sequential", "commands": [{ "id": "scan-rls-policies", "args": "--all-tables" }], "depends_on": [] }, 
      { "id": "enforce", "name": "Enforce RLS", "mode": "sequential", "commands": [{ "id": "enforce-rls", "args": "--strict" }], "depends_on": [\"scan\"] }, 
      { "id": "audit", "name": "Audit Log Report", "mode": "sequential", "commands": [{ "id": "audit-log-report", "args": "--last-30d" }], "depends_on": [\"enforce\"] }]
  }
}
