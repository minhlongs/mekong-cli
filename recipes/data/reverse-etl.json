{
  "id": "data-reverse-etl",
  "name": "Reverse ETL",
  "description": "Reverse ETL pipeline",
  "trigger": "/data:reverse-etl",
  "output_dir": "reports/data/reverse-etl",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      { "id": "select", "name": "Select Segments", "mode": "sequential", "commands": [{ "id": "select-segments", "args": "--audience-builder" }], "depends_on": [] }, 
      { "id": "sync", "name": "Sync Destinations", "mode": "sequential", "commands": [{ "id": "sync-destinations", "args": "--crm,marketing" }], "depends_on": ["select"] }, 
      { "id": "verify", "name": "Verify Delivery", "mode": "sequential", "commands": [{ "id": "verify-delivery", "args": "--row-match" }], "depends_on": ["sync"] }]
  }
}
