{
  "id": "data-quality",
  "name": "Data Quality",
  "description": "Data quality monitoring pipeline",
  "trigger": "/data:quality",
  "output_dir": "reports/data/quality",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      { "id": "checks", "name": "Quality Checks", "mode": "parallel", "commands": [{ "id": "freshness-check", "args": "--sla 4h" }, { "id": "volume-check", "args": "--threshold 10pct" }, { "id": "schema-check", "args": "--diff" }], "depends_on": [] }, 
      { "id": "alert", "name": "Alert Report", "mode": "sequential", "commands": [{ "id": "alert-report", "args": "--slack-notify" }], "depends_on": [\"checks\"] }]
  }
}
