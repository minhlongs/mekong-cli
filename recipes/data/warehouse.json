{
  "id": "data-warehouse",
  "name": "Warehouse Admin",
  "description": "Warehouse admin and cost monitoring",
  "trigger": "/data:warehouse",
  "output_dir": "reports/data/warehouse",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      { "id": "usage", "name": "Usage Stats", "mode": "sequential", "commands": [{ "id": "warehouse-usage", "args": "--last-30d" }], "depends_on": [] }, 
      { "id": "cost", "name": "Cost Analysis", "mode": "sequential", "commands": [{ "id": "warehouse-cost", "args": "--per-query" }], "depends_on": [\"usage\"] }, 
      { "id": "optimize", "name": "Optimization Recs", "mode": "sequential", "commands": [{ "id": "warehouse-optimize", "args": "--auto-suspend" }], "depends_on": [\"cost\"] }]
  }
}
