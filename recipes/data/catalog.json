{
  "id": "data-catalog",
  "name": "Data Catalog",
  "description": "Data discovery and lineage tracking",
  "trigger": "/data:catalog",
  "output_dir": "reports/data/catalog",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      { "id": "crawl", "name": "Crawl Sources", "mode": "sequential", "commands": [{ "id": "crawl-sources", "args": "--all-databases" }], "depends_on": [] }, 
      { "id": "classify", "name": "Classify PII", "mode": "sequential", "commands": [{ "id": "classify-pii", "args": "--gdpr-tags" }], "depends_on": [\"crawl\"] }, 
      { "id": "publish", "name": "Publish Catalog", "mode": "sequential", "commands": [{ "id": "publish-catalog", "args": "--searchable" }], "depends_on": [\"classify\"] }]
  }
}
