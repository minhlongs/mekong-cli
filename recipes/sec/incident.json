{
  "id": "sec-incident",
  "name": "Incident Response",
  "description": "Security incident response pipeline",
  "trigger": "/sec:incident",
  "output_dir": "reports/sec/incident",
  "estimated_credits": 5,
  "estimated_minutes": 15,
  "dag": {
    "groups": [
      {
        "id": "detect-triage",
        "name": "Detect and Triage",
        "mode": "parallel",
        "commands": [{ "id": "detect-threat", "args": "--realtime" }, { "id": "triage-severity", "args": "--sla" }],
        "depends_on": []
      }, 
      {
        "id": "contain",
        "name": "Contain Threat",
        "mode": "sequential",
        "commands": [{ "id": "contain-threat", "args": "--isolate" }],
        "depends_on": ["detect-triage"]
      }, 
      {
        "id": "remediate",
        "name": "Remediate",
        "mode": "sequential",
        "commands": [{ "id": "remediate-incident", "args": "--verify" }],
        "depends_on": ["contain"]
      }, 
      {
        "id": "postmortem",
        "name": "Postmortem",
        "mode": "sequential",
        "commands": [{ "id": "write-postmortem", "args": "--template blameless" }],
        "depends_on": ["remediate"]
      }]
  }
}
