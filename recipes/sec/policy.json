{
  "id": "sec-policy",
  "name": "Policy Enforcement",
  "description": "Policy-as-code enforcement pipeline",
  "trigger": "/sec:policy",
  "output_dir": "reports/sec/policy",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "scan",
        "name": "Policy Scan",
        "mode": "sequential",
        "commands": [{ "id": "policy-scan", "args": "--all" }],
        "depends_on": []
      }, 
      {
        "id": "drift",
        "name": "Drift Detection",
        "mode": "sequential",
        "commands": [{ "id": "drift-detect", "args": "--baseline" }],
        "depends_on": ["scan"]
      }, 
      {
        "id": "enforce",
        "name": "Enforce Policies",
        "mode": "sequential",
        "commands": [{ "id": "policy-enforce", "args": "--auto-remediate" }],
        "depends_on": ["drift"]
      }]
  }
}
