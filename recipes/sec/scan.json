{
  "id": "sec-scan",
  "name": "Security Scan",
  "description": "SAST/DAST/SCA scanning pipeline",
  "trigger": "/sec:scan",
  "output_dir": "reports/sec/scan",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {
        "id": "scan-parallel",
        "name": "Static + Dynamic + SCA Scans",
        "mode": "parallel",
        "commands": [{ "id": "sast-scan", "args": "--all" }, { "id": "dast-scan", "args": "--target \$URL" }, { "id": "sca-scan", "args": "--deps" }],
        "depends_on": []
      }, 
      {
        "id": "report",
        "name": "Compile Report",
        "mode": "sequential",
        "commands": [{ "id": "compile-report", "args": "--format markdown" }],
        "depends_on": [\"scan-parallel\"]
      }]
  }
}
