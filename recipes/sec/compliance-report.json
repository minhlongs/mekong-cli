{
  "id": "sec-compliance-report",
  "name": "Compliance Report",
  "description": "Generate compliance evidence packages",
  "trigger": "/sec:compliance-report",
  "output_dir": "reports/sec/compliance-report",
  "estimated_credits": 5,
  "estimated_minutes": 15,
  "dag": {
    "groups": [
      {
        "id": "collect",
        "name": "Collect Evidence",
        "mode": "parallel",
        "commands": [{ "id": "collect-soc2", "args": "--controls" }, { "id": "collect-iso27001", "args": "--annex-a" }, { "id": "collect-sox", "args": "--icfr" }],
        "depends_on": []
      }, 
      {
        "id": "package",
        "name": "Package Evidence",
        "mode": "sequential",
        "commands": [{ "id": "package-evidence", "args": "--format audit-ready" }],
        "depends_on": [\"collect\"]
      }]
  }
}
