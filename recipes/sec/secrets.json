{
  "id": "sec-secrets",
  "name": "Secrets Management",
  "description": "Secrets management and rotation pipeline",
  "trigger": "/sec:secrets",
  "output_dir": "reports/sec/secrets",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "scan",
        "name": "Vault Check + Leak Scan",
        "mode": "parallel",
        "commands": [{ "id": "vault-check", "args": "--all-vaults" }, { "id": "leak-scan", "args": "--repos" }],
        "depends_on": []
      }, 
      {
        "id": "rotate",
        "name": "Rotate Expired",
        "mode": "sequential",
        "commands": [{ "id": "rotate-secrets", "args": "--expired-only" }],
        "depends_on": ["scan"]
      }]
  }
}
