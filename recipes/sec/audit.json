{
  "id": "sec-audit",
  "name": "Compliance Audit",
  "description": "Continuous compliance monitoring pipeline",
  "trigger": "/sec:audit",
  "output_dir": "reports/sec/audit",
  "estimated_credits": 5,
  "estimated_minutes": 20,
  "dag": {
    "groups": [
      {
        "id": "collect",
        "name": "Evidence Collection",
        "mode": "sequential",
        "commands": [{ "id": "evidence-collect", "args": "--frameworks soc2,iso27001" }],
        "depends_on": []
      }, 
      {
        "id": "analyze",
        "name": "Gap Analysis",
        "mode": "sequential",
        "commands": [{ "id": "gap-analyze", "args": "--severity critical,high" }],
        "depends_on": ["collect"]
      }, 
      {
        "id": "remediate",
        "name": "Remediation Plan",
        "mode": "sequential",
        "commands": [{ "id": "remediation-plan", "args": "--priority-sort" }],
        "depends_on": ["analyze"]
      }]
  }
}
