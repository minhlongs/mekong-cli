{
  "id": "sec-access-review",
  "name": "Access Review",
  "description": "SOX quarterly access recertification pipeline",
  "trigger": "/sec:access-review",
  "output_dir": "reports/sec/access-review",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {
        "id": "extract",
        "name": "Extract Access",
        "mode": "sequential",
        "commands": [{ "id": "extract-access", "args": "--all-systems" }],
        "depends_on": []
      }, 
      {
        "id": "review",
        "name": "Send for Review",
        "mode": "sequential",
        "commands": [{ "id": "send-review", "args": "--managers" }],
        "depends_on": [\"extract\"]
      }, 
      {
        "id": "attest",
        "name": "Collect Attestation",
        "mode": "sequential",
        "commands": [{ "id": "collect-attestation", "args": "--deadline 14d" }],
        "depends_on": [\"review\"]
      }, 
      {
        "id": "remediate",
        "name": "Remediate Exceptions",
        "mode": "sequential",
        "commands": [{ "id": "remediate-access", "args": "--revoke-unattested" }],
        "depends_on": [\"attest\"]
      }]
  }
}
