{
  "id": "sec-vuln",
  "name": "Vulnerability Management",
  "description": "Vulnerability management lifecycle",
  "trigger": "/sec:vuln",
  "output_dir": "reports/sec/vuln",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {
        "id": "scan",
        "name": "Vulnerability Scan",
        "mode": "sequential",
        "commands": [{ "id": "vuln-scan", "args": "--all-targets" }],
        "depends_on": []
      }, 
      {
        "id": "prioritize",
        "name": "Prioritize by Severity",
        "mode": "sequential",
        "commands": [{ "id": "vuln-prioritize", "args": "--cvss-sort" }],
        "depends_on": ["scan"]
      }, 
      {
        "id": "assign",
        "name": "Assign SLAs",
        "mode": "sequential",
        "commands": [{ "id": "vuln-assign-sla", "args": "--policy default" }],
        "depends_on": ["prioritize"]
      }, 
      {
        "id": "track",
        "name": "Track Remediation",
        "mode": "sequential",
        "commands": [{ "id": "vuln-track", "args": "--dashboard" }],
        "depends_on": ["assign"]
      }]
  }
}
