{
  "id": "pm-analytics",
  "name": "Product Analytics",
  "description": "Analytics pipeline",
  "trigger": "/pm:analytics",
  "output_dir": "reports/pm/analytics",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "analyze", "name": "Funnel + Adoption Analysis", "mode": "parallel", "commands": [{"id": "funnel-analysis", "args": "--steps"}, {"id": "adoption-tracking", "args": "--features"}], "depends_on": []},
      {"id": "report", "name": "Insights Report", "mode": "sequential", "commands": [{"id": "insights-report", "args": "--executive"}], "depends_on": ["analyze"]}
    ]
  }
}
