{
  "id": "pm-feature-flag",
  "name": "Feature Flags",
  "description": "Progressive rollout pipeline",
  "trigger": "/pm:feature-flag",
  "output_dir": "reports/pm/feature-flag",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "create", "name": "Create Flag", "mode": "sequential", "commands": [{"id": "create-flag", "args": "--name"}], "depends_on": []},
      {"id": "rollout", "name": "Configure Rollout", "mode": "sequential", "commands": [{"id": "configure-rollout", "args": "--percentage 10"}], "depends_on": ["create"]},
      {"id": "monitor", "name": "Monitor Metrics", "mode": "sequential", "commands": [{"id": "monitor-metrics", "args": "--guardrails"}], "depends_on": ["rollout"]}
    ]
  }
}
