{
  "id": "pm-competitor",
  "name": "Competitive Intel",
  "description": "Competitive analysis pipeline",
  "trigger": "/pm:competitor",
  "output_dir": "reports/pm/competitor",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "scan", "name": "Scan Competitors", "mode": "sequential", "commands": [{"id": "scan-competitors", "args": "--market"}], "depends_on": []},
      {"id": "analyze", "name": "Analyze Features", "mode": "sequential", "commands": [{"id": "analyze-features", "args": "--matrix"}], "depends_on": ["scan"]},
      {"id": "gap", "name": "Gap Report", "mode": "sequential", "commands": [{"id": "competitor-gap-report", "args": "--opportunities"}], "depends_on": ["analyze"]}
    ]
  }
}
