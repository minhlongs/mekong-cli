{
  "id": "pm-feedback",
  "name": "User Feedback",
  "description": "Feedback routing pipeline",
  "trigger": "/pm:feedback",
  "output_dir": "reports/pm/feedback",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "collect", "name": "Collect Feedback", "mode": "sequential", "commands": [{"id": "collect-feedback", "args": "--all-channels"}], "depends_on": []},
      {"id": "categorize", "name": "Categorize", "mode": "sequential", "commands": [{"id": "categorize-feedback", "args": "--nlp"}], "depends_on": ["collect"]},
      {"id": "route", "name": "Route to Backlog", "mode": "sequential", "commands": [{"id": "route-to-backlog", "args": "--auto-tag"}], "depends_on": ["categorize"]}
    ]
  }
}
