{
  "id": "pm-release-note",
  "name": "Release Notes",
  "description": "Changelog pipeline",
  "trigger": "/pm:release-note",
  "output_dir": "reports/pm/release-note",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {"id": "generate", "name": "Generate Changelog", "mode": "sequential", "commands": [{"id": "generate-changelog", "args": "--from-commits"}], "depends_on": []},
      {"id": "format", "name": "Format Notes", "mode": "sequential", "commands": [{"id": "format-notes", "args": "--user-facing"}], "depends_on": ["generate"]},
      {"id": "distribute", "name": "Distribute", "mode": "sequential", "commands": [{"id": "distribute-notes", "args": "--email,slack"}], "depends_on": ["format"]}
    ]
  }
}
