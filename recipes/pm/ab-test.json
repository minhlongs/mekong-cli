{
  "id": "pm-ab-test",
  "name": "A/B Testing",
  "description": "Experiment pipeline",
  "trigger": "/pm:ab-test",
  "output_dir": "reports/pm/ab-test",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "design", "name": "Design Experiment", "mode": "sequential", "commands": [{"id": "design-experiment", "args": "--hypothesis"}], "depends_on": []},
      {"id": "launch", "name": "Launch", "mode": "sequential", "commands": [{"id": "launch-experiment", "args": "--split 50-50"}], "depends_on": ["design"]},
      {"id": "analyze", "name": "Analyze Stats", "mode": "sequential", "commands": [{"id": "analyze-stats", "args": "--significance 0.05"}], "depends_on": ["launch"]},
      {"id": "decide", "name": "Decide Rollback", "mode": "sequential", "commands": [{"id": "decide-rollback", "args": "--auto"}], "depends_on": ["analyze"]}
    ]
  }
}
