{
  "id": "pm-backlog",
  "name": "Backlog Management",
  "description": "Sprint grooming pipeline",
  "trigger": "/pm:backlog",
  "output_dir": "reports/pm/backlog",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "triage", "name": "Triage Stories", "mode": "sequential", "commands": [{"id": "triage-stories", "args": "--ungroomed"}], "depends_on": []},
      {"id": "estimate", "name": "Estimate", "mode": "sequential", "commands": [{"id": "estimate-stories", "args": "--story-points"}], "depends_on": ["triage"]},
      {"id": "groom", "name": "Groom", "mode": "sequential", "commands": [{"id": "groom-sprint", "args": "--capacity"}], "depends_on": ["estimate"]},
      {"id": "assign", "name": "Assign Sprint", "mode": "sequential", "commands": [{"id": "assign-sprint", "args": "--next"}], "depends_on": ["groom"]}
    ]
  }
}
