{
  "id": "pm-roadmap",
  "name": "Roadmap Planning",
  "description": "Roadmap prioritization pipeline",
  "trigger": "/pm:roadmap",
  "output_dir": "reports/pm/roadmap",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "gather", "name": "Gather Inputs", "mode": "sequential", "commands": [{"id": "gather-inputs", "args": "--stakeholders"}], "depends_on": []},
      {"id": "score", "name": "Score RICE", "mode": "sequential", "commands": [{"id": "score-rice", "args": "--framework rice"}], "depends_on": ["gather"]},
      {"id": "prioritize", "name": "Prioritize", "mode": "sequential", "commands": [{"id": "prioritize-items", "args": "--top-20"}], "depends_on": ["score"]},
      {"id": "publish", "name": "Publish Roadmap", "mode": "sequential", "commands": [{"id": "publish-roadmap", "args": "--format gantt"}], "depends_on": ["prioritize"]}
    ]
  }
}
