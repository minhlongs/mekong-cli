{
  "id": "context-strategy",
  "name": "Context Strategy",
  "description": "Context management",
  "trigger": "/context:strategy",
  "output_dir": "reports/context/strategy",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": { "groups": [
      {"id": "analyze", "name": "Analyze Usage", "mode": "sequential", "commands": [{"id": "analyze-context", "args": "--token-distribution"}], "depends_on": []},
      {"id": "classify", "name": "Classify Priority", "mode": "sequential", "commands": [{"id": "classify-priority", "args": "--critical,useful,noise"}], "depends_on": ["analyze"]},
      {"id": "optimize", "name": "Optimize Allocation", "mode": "sequential", "commands": [{"id": "optimize-allocation", "args": "--budget"}], "depends_on": ["classify"]}] }
}
