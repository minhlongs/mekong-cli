{
  "id": "it-endpoint",
  "name": "Endpoint Compliance",
  "description": "Device compliance and encryption verification",
  "trigger": "/it:endpoint",
  "output_dir": "reports/it/endpoint",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {
        "id": "check",
        "name": "Endpoint Compliance Check",
        "mode": "sequential",
        "commands": [{ "id": "endpoint-compliance", "args": "--verify-encryption --report" }],
        "depends_on": []
      }]
  }
}
