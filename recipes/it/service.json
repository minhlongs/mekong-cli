{
  "id": "it-service",
  "name": "IT Service Management",
  "description": "IT service management pipeline",
  "trigger": "/it:service",
  "output_dir": "reports/it/service",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "triage",
        "name": "Triage Tickets",
        "mode": "sequential",
        "commands": [{ "id": "triage-tickets", "args": "--queue all" }],
        "depends_on": []
      }, 
      {
        "id": "prioritize",
        "name": "Prioritize",
        "mode": "sequential",
        "commands": [{ "id": "prioritize-tickets", "args": "--sla" }],
        "depends_on": [\"triage\"]
      }, 
      {
        "id": "assign",
        "name": "Assign",
        "mode": "sequential",
        "commands": [{ "id": "assign-tickets", "args": "--auto-route" }],
        "depends_on": [\"prioritize\"]
      }]
  }
}
