{
  "id": "it-inventory",
  "name": "IT Inventory",
  "description": "SaaS discovery and license tracking pipeline",
  "trigger": "/it:inventory",
  "output_dir": "reports/it/inventory",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {
        "id": "scan",
        "name": "Scan SaaS + Endpoints",
        "mode": "parallel",
        "commands": [{ "id": "scan-saas", "args": "--oauth-discovery" }, { "id": "scan-endpoints", "args": "--mdm" }],
        "depends_on": []
      }, 
      {
        "id": "reconcile",
        "name": "Reconcile Licenses",
        "mode": "sequential",
        "commands": [{ "id": "reconcile-licenses", "args": "--cost-optimize" }],
        "depends_on": [\"scan\"]
      }]
  }
}
