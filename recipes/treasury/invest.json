{
  "id": "treasury-invest",
  "name": "Investment Policy",
  "description": "Investment policy management",
  "trigger": "/treasury:invest",
  "output_dir": "reports/treasury/invest",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "review", "name": "Review Policy", "mode": "sequential", "commands": [{"id": "review-policy", "args": "--current"}], "depends_on": []},
      {"id": "assess", "name": "Assess Options", "mode": "sequential", "commands": [{"id": "assess-options", "args": "--money-market,tbills"}], "depends_on": ["review"]},
      {"id": "allocate", "name": "Allocate", "mode": "sequential", "commands": [{"id": "allocate-funds", "args": "--policy-compliant"}], "depends_on": ["assess"]}
    ]
  }
}
