{
  "id": "treasury-position",
  "name": "Cash Position",
  "description": "Daily cash position",
  "trigger": "/treasury:position",
  "output_dir": "reports/treasury/position",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {"id": "aggregate", "name": "Aggregate Accounts", "mode": "sequential", "commands": [{"id": "aggregate-accounts", "args": "--all-banks"}], "depends_on": []},
      {"id": "reconcile", "name": "Reconcile", "mode": "sequential", "commands": [{"id": "reconcile-cash", "args": "--daily"}], "depends_on": ["aggregate"]},
      {"id": "dashboard", "name": "Dashboard", "mode": "sequential", "commands": [{"id": "cash-dashboard", "args": "--realtime"}], "depends_on": ["reconcile"]}
    ]
  }
}
