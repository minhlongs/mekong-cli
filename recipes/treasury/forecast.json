{
  "id": "treasury-forecast",
  "name": "Cash Forecast",
  "description": "13-week cash forecast",
  "trigger": "/treasury:forecast",
  "output_dir": "reports/treasury/forecast",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "actuals", "name": "Pull Actuals", "mode": "sequential", "commands": [{"id": "pull-actuals", "args": "--last-4w"}], "depends_on": []},
      {"id": "inflows", "name": "Project Inflows", "mode": "sequential", "commands": [{"id": "project-inflows", "args": "--ar-schedule"}], "depends_on": ["actuals"]},
      {"id": "outflows", "name": "Project Outflows", "mode": "sequential", "commands": [{"id": "project-outflows", "args": "--ap-schedule"}], "depends_on": ["inflows"]},
      {"id": "model", "name": "Forecast Model", "mode": "sequential", "commands": [{"id": "cash-model", "args": "--13-week-rolling"}], "depends_on": ["outflows"]}
    ]
  }
}
