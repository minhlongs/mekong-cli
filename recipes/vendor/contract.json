{
  "id": "vendor-contract",
  "name": "Vendor Contracts",
  "description": "Contract management",
  "trigger": "/vendor:contract",
  "output_dir": "reports/vendor/contract",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "import", "name": "Import Contract", "mode": "sequential", "commands": [{"id": "import-contract", "args": "--ocr"}], "depends_on": []},
      {"id": "extract", "name": "Extract Terms", "mode": "sequential", "commands": [{"id": "extract-terms", "args": "--sla,renewal,termination"}], "depends_on": ["import"]},
      {"id": "track", "name": "Track SLAs", "mode": "sequential", "commands": [{"id": "track-slas", "args": "--alert-30d"}], "depends_on": ["extract"]}
    ]
  }
}
