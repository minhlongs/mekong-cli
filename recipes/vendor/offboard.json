{
  "id": "vendor-offboard",
  "name": "Vendor Offboard",
  "description": "Vendor offboarding",
  "trigger": "/vendor:offboard",
  "output_dir": "reports/vendor/offboard",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {"id": "revoke", "name": "Revoke Access", "mode": "sequential", "commands": [{"id": "revoke-vendor-access", "args": "--immediate"}], "depends_on": []},
      {"id": "delete", "name": "Delete Data", "mode": "sequential", "commands": [{"id": "delete-vendor-data", "args": "--gdpr-compliant"}], "depends_on": ["revoke"]},
      {"id": "evidence", "name": "Generate Evidence", "mode": "sequential", "commands": [{"id": "vendor-evidence", "args": "--audit-trail"}], "depends_on": ["delete"]}
    ]
  }
}
