{
  "id": "vendor-assess",
  "name": "Vendor Assessment",
  "description": "Vendor risk assessment",
  "trigger": "/vendor:assess",
  "output_dir": "reports/vendor/assess",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "questionnaire", "name": "Collect Questionnaire", "mode": "sequential", "commands": [{"id": "collect-questionnaire", "args": "--security"}], "depends_on": []},
      {"id": "tier", "name": "Risk Tier", "mode": "sequential", "commands": [{"id": "risk-tier", "args": "--critical,high,medium,low"}], "depends_on": ["questionnaire"]},
      {"id": "verify", "name": "Verify SOC 2", "mode": "sequential", "commands": [{"id": "verify-soc2", "args": "--type-ii"}], "depends_on": ["tier"]}
    ]
  }
}
