{
  "id": "vendor-spend",
  "name": "Vendor Spend",
  "description": "Vendor spend optimization",
  "trigger": "/vendor:spend",
  "output_dir": "reports/vendor/spend",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "invoices", "name": "Collect Invoices", "mode": "sequential", "commands": [{"id": "collect-invoices", "args": "--all-vendors"}], "depends_on": []},
      {"id": "usage", "name": "Analyze Usage", "mode": "sequential", "commands": [{"id": "analyze-usage", "args": "--per-seat"}], "depends_on": ["invoices"]},
      {"id": "optimize", "name": "Optimize", "mode": "sequential", "commands": [{"id": "optimize-licenses", "args": "--unused-seats"}], "depends_on": ["usage"]}
    ]
  }
}
