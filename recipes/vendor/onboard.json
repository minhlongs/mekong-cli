{
  "id": "vendor-onboard",
  "name": "Vendor Onboard",
  "description": "Vendor onboarding",
  "trigger": "/vendor:onboard",
  "output_dir": "reports/vendor/onboard",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "intake", "name": "Intake Form", "mode": "sequential", "commands": [{"id": "vendor-intake", "args": "--new"}], "depends_on": []},
      {"id": "security", "name": "Security Review", "mode": "sequential", "commands": [{"id": "security-review", "args": "--questionnaire"}], "depends_on": ["intake"]},
      {"id": "approve", "name": "Approve", "mode": "sequential", "commands": [{"id": "approve-vendor", "args": "--risk-acceptance"}], "depends_on": ["security"]},
      {"id": "setup", "name": "Setup Access", "mode": "sequential", "commands": [{"id": "setup-vendor-access", "args": "--sso"}], "depends_on": ["approve"]}
    ]
  }
}
