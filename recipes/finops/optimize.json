{
  "id": "finops-optimize",
  "name": "Cloud Optimize",
  "description": "Cloud optimization",
  "trigger": "/finops:optimize",
  "output_dir": "reports/finops/optimize",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "analyze", "name": "RI Analysis + Rightsizing", "mode": "parallel", "commands": [{"id": "ri-analysis", "args": "--savings-plan"}, {"id": "rightsizing-scan", "args": "--underutilized"}], "depends_on": []},
      {"id": "recs", "name": "Recommendations", "mode": "sequential", "commands": [{"id": "optimization-recs", "args": "--roi-sorted"}], "depends_on": ["analyze"]}
    ]
  }
}
