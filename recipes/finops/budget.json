{
  "id": "finops-budget",
  "name": "Cloud Budget",
  "description": "Cloud budget management",
  "trigger": "/finops:budget",
  "output_dir": "reports/finops/budget",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {"id": "budgets", "name": "Set Budgets", "mode": "sequential", "commands": [{"id": "set-budgets", "args": "--per-team"}], "depends_on": []},
      {"id": "alerts", "name": "Configure Alerts", "mode": "sequential", "commands": [{"id": "configure-alerts", "args": "--80pct,100pct"}], "depends_on": ["budgets"]},
      {"id": "approval", "name": "Approval Flow", "mode": "sequential", "commands": [{"id": "approval-flow", "args": "--manager-chain"}], "depends_on": ["alerts"]}
    ]
  }
}
