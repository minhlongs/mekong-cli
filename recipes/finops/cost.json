{
  "id": "finops-cost",
  "name": "Cloud Cost",
  "description": "Cloud cost allocation",
  "trigger": "/finops:cost",
  "output_dir": "reports/finops/cost",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "collect", "name": "Collect Usage", "mode": "sequential", "commands": [{"id": "collect-usage", "args": "--all-providers"}], "depends_on": []},
      {"id": "tag", "name": "Tag and Allocate", "mode": "sequential", "commands": [{"id": "tag-allocate", "args": "--per-customer"}], "depends_on": ["collect"]},
      {"id": "report", "name": "Cost Report", "mode": "sequential", "commands": [{"id": "cost-report", "args": "--executive"}], "depends_on": ["tag"]}
    ]
  }
}
