{
  "id": "devrel-sdk",
  "name": "SDK Publishing",
  "description": "SDK publish pipeline",
  "trigger": "/devrel:sdk",
  "output_dir": "reports/devrel/sdk",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "build", "name": "Build SDKs", "mode": "sequential", "commands": [{"id": "build-sdks", "args": "--all-languages"}], "depends_on": []},
      {"id": "test", "name": "Test Compatibility", "mode": "sequential", "commands": [{"id": "test-compat", "args": "--matrix"}], "depends_on": ["build"]},
      {"id": "publish", "name": "Publish", "mode": "sequential", "commands": [{"id": "publish-sdks", "args": "--npm,pypi,maven"}], "depends_on": ["test"]}
    ]
  }
}
