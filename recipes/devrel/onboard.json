{
  "id": "devrel-onboard",
  "name": "Developer Onboard",
  "description": "Developer onboarding",
  "trigger": "/devrel:onboard",
  "output_dir": "reports/devrel/onboard",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "sandbox", "name": "Setup Sandbox", "mode": "sequential", "commands": [{"id": "setup-sandbox", "args": "--api-key"}], "depends_on": []},
      {"id": "tutorial", "name": "Guided Tutorial", "mode": "sequential", "commands": [{"id": "guided-tutorial", "args": "--quickstart"}], "depends_on": ["sandbox"]},
      {"id": "track", "name": "Track TTFS", "mode": "sequential", "commands": [{"id": "track-ttfs", "args": "--funnel"}], "depends_on": ["tutorial"]}
    ]
  }
}
