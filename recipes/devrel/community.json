{
  "id": "devrel-community",
  "name": "Community Management",
  "description": "Community engagement",
  "trigger": "/devrel:community",
  "output_dir": "reports/devrel/community",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "stats", "name": "Discord + Forum Stats", "mode": "parallel", "commands": [{"id": "discord-stats", "args": "--monthly"}, {"id": "forum-stats", "args": "--monthly"}], "depends_on": []},
      {"id": "report", "name": "Engagement Report", "mode": "sequential", "commands": [{"id": "engagement-report", "args": "--trends"}], "depends_on": ["stats"]}
    ]
  }
}
