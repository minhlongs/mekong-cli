{
  "id": "devrel-docs",
  "name": "API Docs",
  "description": "API documentation pipeline",
  "trigger": "/devrel:docs",
  "output_dir": "reports/devrel/docs",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "extract", "name": "Extract OpenAPI", "mode": "sequential", "commands": [{"id": "extract-openapi", "args": "--from-code"}], "depends_on": []},
      {"id": "generate", "name": "Generate Docs", "mode": "sequential", "commands": [{"id": "generate-docs", "args": "--template developer"}], "depends_on": ["extract"]},
      {"id": "publish", "name": "Version and Publish", "mode": "sequential", "commands": [{"id": "version-publish", "args": "--semver"}], "depends_on": ["generate"]}
    ]
  }
}
