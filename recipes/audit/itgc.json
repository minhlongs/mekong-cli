{
  "id": "audit-itgc",
  "name": "ITGC Testing",
  "description": "IT General Controls testing pipeline",
  "trigger": "/audit:itgc",
  "output_dir": "reports/audit/itgc",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {
        "id": "test",
        "name": "Access + Change Mgmt + Ops",
        "mode": "parallel",
        "commands": [{ "id": "test-access-controls", "args": "--all-systems" }, { "id": "test-change-mgmt", "args": "--sdlc" }, { "id": "test-operations", "args": "--backup-recovery" }],
        "depends_on": []
      }, 
      {
        "id": "report",
        "name": "Findings Report",
        "mode": "sequential",
        "commands": [{ "id": "itgc-report", "args": "--gap-analysis" }],
        "depends_on": [\"test\"]
      }]
  }
}
