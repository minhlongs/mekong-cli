{
  "id": "audit-execute",
  "name": "Audit Execution",
  "description": "Fieldwork tracking and evidence collection",
  "trigger": "/audit:execute",
  "output_dir": "reports/audit/execute",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {
        "id": "assign",
        "name": "Assign Fieldwork",
        "mode": "sequential",
        "commands": [{ "id": "assign-fieldwork", "args": "--audit-plan" }],
        "depends_on": []
      }, 
      {
        "id": "collect",
        "name": "Collect Evidence",
        "mode": "sequential",
        "commands": [{ "id": "collect-evidence", "args": "--chain-of-custody" }],
        "depends_on": ["assign"]
      }, 
      {
        "id": "document",
        "name": "Document Findings",
        "mode": "sequential",
        "commands": [{ "id": "document-findings", "args": "--severity-rating" }],
        "depends_on": ["collect"]
      }]
  }
}
