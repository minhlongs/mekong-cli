{
  "id": "audit-plan",
  "name": "Audit Planning",
  "description": "Risk-based audit planning pipeline",
  "trigger": "/audit:plan",
  "output_dir": "reports/audit/plan",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {
        "id": "rank",
        "name": "Risk Rank",
        "mode": "sequential",
        "commands": [{ "id": "risk-rank", "args": "--annual" }],
        "depends_on": []
      }, 
      {
        "id": "select",
        "name": "Select Audits",
        "mode": "sequential",
        "commands": [{ "id": "select-audits", "args": "--budget-constrained" }],
        "depends_on": [\"rank\"]
      }, 
      {
        "id": "allocate",
        "name": "Allocate Resources",
        "mode": "sequential",
        "commands": [{ "id": "allocate-resources", "args": "--team-capacity" }],
        "depends_on": [\"select\"]
      }]
  }
}
