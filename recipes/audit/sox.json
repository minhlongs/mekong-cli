{
  "id": "audit-sox",
  "name": "SOX Testing",
  "description": "SOX ICFR testing pipeline",
  "trigger": "/audit:sox",
  "output_dir": "reports/audit/sox",
  "estimated_credits": 5,
  "estimated_minutes": 20,
  "dag": {
    "groups": [
      {
        "id": "test",
        "name": "Walkthrough + Design Test",
        "mode": "parallel",
        "commands": [{ "id": "sox-walkthrough", "args": "--key-controls" }, { "id": "sox-design-test", "args": "--assertions" }],
        "depends_on": []
      }, 
      {
        "id": "oe",
        "name": "Operating Effectiveness",
        "mode": "sequential",
        "commands": [{ "id": "sox-oe-test", "args": "--sample-size 25" }],
        "depends_on": ["test"]
      }, 
      {
        "id": "report",
        "name": "Deficiency Report",
        "mode": "sequential",
        "commands": [{ "id": "deficiency-report", "args": "--material-weakness-check" }],
        "depends_on": ["oe"]
      }]
  }
}
