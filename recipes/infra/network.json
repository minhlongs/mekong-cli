{
  "id": "infra-network",
  "name": "Network Audit",
  "description": "Network architecture audit",
  "trigger": "/infra:network",
  "output_dir": "reports/infra/network",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "scan", "name": "Firewall + DNS + Segments", "mode": "parallel", "commands": [{"id": "scan-firewall", "args": "--rules"}, {"id": "scan-dns", "args": "--zones"}, {"id": "scan-segments", "args": "--vlans"}], "depends_on": []},
      {"id": "report", "name": "Audit Report", "mode": "sequential", "commands": [{"id": "network-audit-report", "args": "--gaps"}], "depends_on": ["scan"]}] }
}
