{
  "id": "infra-optimize",
  "name": "Infra Optimize",
  "description": "Infrastructure optimization",
  "trigger": "/infra:optimize",
  "output_dir": "reports/infra/optimize",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "benchmark", "name": "Benchmark Current", "mode": "sequential", "commands": [{"id": "benchmark-infra", "args": "--baseline"}], "depends_on": []},
      {"id": "waste", "name": "Identify Waste", "mode": "sequential", "commands": [{"id": "identify-waste", "args": "--idle-resources"}], "depends_on": ["benchmark"]},
      {"id": "recommend", "name": "Recommend Changes", "mode": "sequential", "commands": [{"id": "recommend-infra", "args": "--roi-sorted"}], "depends_on": ["waste"]}] }
}
