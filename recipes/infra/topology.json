{
  "id": "infra-topology",
  "name": "Infra Topology",
  "description": "Infrastructure topology mapping",
  "trigger": "/infra:topology",
  "output_dir": "reports/infra/topology",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "scan", "name": "Scan Services + Deps", "mode": "parallel", "commands": [{"id": "scan-services", "args": "--all"}, {"id": "scan-deps", "args": "--graph"}], "depends_on": []},
      {"id": "map", "name": "Topology Map", "mode": "sequential", "commands": [{"id": "topology-map", "args": "--viz"}], "depends_on": ["scan"]}] }
}
