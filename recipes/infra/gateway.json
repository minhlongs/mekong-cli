{
  "id": "infra-gateway",
  "name": "API Gateway",
  "description": "Gateway configuration",
  "trigger": "/infra:gateway",
  "output_dir": "reports/infra/gateway",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": { "groups": [
      {"id": "routes", "name": "Scan Routes", "mode": "sequential", "commands": [{"id": "scan-routes", "args": "--openapi"}], "depends_on": []},
      {"id": "auth", "name": "Configure Auth", "mode": "sequential", "commands": [{"id": "configure-auth", "args": "--jwt,api-key"}], "depends_on": ["routes"]},
      {"id": "limits", "name": "Set Rate Limits", "mode": "sequential", "commands": [{"id": "set-rate-limits", "args": "--per-tier"}], "depends_on": ["auth"]}] }
}
