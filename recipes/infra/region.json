{
  "id": "infra-region",
  "name": "Region Planning",
  "description": "Region deployment planning",
  "trigger": "/infra:region",
  "output_dir": "reports/infra/region",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "latency", "name": "Latency Analysis", "mode": "sequential", "commands": [{"id": "latency-analysis", "args": "--global-users"}], "depends_on": []},
      {"id": "compliance", "name": "Compliance Check", "mode": "sequential", "commands": [{"id": "region-compliance", "args": "--gdpr,ccpa"}], "depends_on": ["latency"]},
      {"id": "cost", "name": "Cost Model", "mode": "sequential", "commands": [{"id": "region-cost", "args": "--per-region"}], "depends_on": ["compliance"]},
      {"id": "recommend", "name": "Recommend", "mode": "sequential", "commands": [{"id": "region-recommend", "args": "--optimized"}], "depends_on": ["cost"]}] }
}
