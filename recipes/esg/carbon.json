{
  "id": "esg-carbon",
  "name": "Carbon Tracking",
  "description": "Carbon footprint tracking",
  "trigger": "/esg:carbon",
  "output_dir": "reports/esg/carbon",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "s1", "name": "Measure Scope 1", "mode": "sequential", "commands": [{"id": "measure-scope1", "args": "--direct-emissions"}], "depends_on": []},
      {"id": "s2", "name": "Measure Scope 2", "mode": "sequential", "commands": [{"id": "measure-scope2", "args": "--electricity,heat"}], "depends_on": ["s1"]},
      {"id": "s3", "name": "Estimate Scope 3", "mode": "sequential", "commands": [{"id": "estimate-scope3", "args": "--supply-chain"}], "depends_on": ["s2"]},
      {"id": "offset", "name": "Offset Plan", "mode": "sequential", "commands": [{"id": "offset-plan", "args": "--science-based-targets"}], "depends_on": ["s3"]}
    ]
  }
}
