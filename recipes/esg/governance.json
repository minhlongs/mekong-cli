{
  "id": "esg-governance",
  "name": "ESG Governance",
  "description": "ESG governance",
  "trigger": "/esg:governance",
  "output_dir": "reports/esg/governance",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "review", "name": "Review Framework", "mode": "sequential", "commands": [{"id": "review-framework", "args": "--materiality-matrix"}], "depends_on": []},
      {"id": "update", "name": "Update Policies", "mode": "sequential", "commands": [{"id": "update-policies", "args": "--stakeholder-input"}], "depends_on": ["review"]},
      {"id": "oversight", "name": "Board Oversight", "mode": "sequential", "commands": [{"id": "board-oversight", "args": "--committee-charter"}], "depends_on": ["update"]}
    ]
  }
}
