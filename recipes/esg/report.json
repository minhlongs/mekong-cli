{
  "id": "esg-report",
  "name": "ESG Report",
  "description": "Sustainability reporting",
  "trigger": "/esg:report",
  "output_dir": "reports/esg/report",
  "estimated_credits": 3,
  "estimated_minutes": 12,
  "dag": {
    "groups": [
      {"id": "collect", "name": "Collect E + S + G Data", "mode": "parallel", "commands": [{"id": "collect-environmental", "args": "--scope-1-3"}, {"id": "collect-social", "args": "--dei,labor"}, {"id": "collect-governance", "args": "--board,ethics"}], "depends_on": []},
      {"id": "compile", "name": "Compile Report", "mode": "sequential", "commands": [{"id": "compile-esg-report", "args": "--gri,sasb"}], "depends_on": ["collect"]}
    ]
  }
}
