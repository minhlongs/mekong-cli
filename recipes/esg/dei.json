{
  "id": "esg-dei",
  "name": "DEI Metrics",
  "description": "DEI reporting",
  "trigger": "/esg:dei",
  "output_dir": "reports/esg/dei",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "collect", "name": "Collect Data", "mode": "sequential", "commands": [{"id": "collect-dei-data", "args": "--demographics"}], "depends_on": []},
      {"id": "analyze", "name": "Analyze Gaps", "mode": "sequential", "commands": [{"id": "analyze-gaps", "args": "--benchmarks"}], "depends_on": ["collect"]},
      {"id": "action", "name": "Action Plan", "mode": "sequential", "commands": [{"id": "dei-action-plan", "args": "--goals"}], "depends_on": ["analyze"]},
      {"id": "report", "name": "DEI Report", "mode": "sequential", "commands": [{"id": "dei-report", "args": "--public"}], "depends_on": ["action"]}
    ]
  }
}
