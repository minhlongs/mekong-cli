{
  "id": "governance-disclosure",
  "name": "SEC Disclosure",
  "description": "SEC disclosure tracking pipeline",
  "trigger": "/governance:disclosure",
  "output_dir": "reports/governance/disclosure",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      { "id": "identify", "name": "Identify Requirements", "mode": "sequential", "commands": [{ "id": "identify-requirements", "args": "--sec-rules" }], "depends_on": [] }, 
      { "id": "track", "name": "Track Deadlines", "mode": "sequential", "commands": [{ "id": "track-deadlines", "args": "--calendar" }], "depends_on": [\"identify\"] }, 
      { "id": "prepare", "name": "Prepare Filings", "mode": "sequential", "commands": [{ "id": "prepare-filings", "args": "--edgar-format" }], "depends_on": [\"track\"] }]
  }
}
