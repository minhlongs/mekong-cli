{
  "id": "governance-entity",
  "name": "Entity Management",
  "description": "Entity management pipeline",
  "trigger": "/governance:entity",
  "output_dir": "reports/governance/entity",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      { "id": "sync", "name": "Entity Inventory + Cap Table", "mode": "parallel", "commands": [{ "id": "entity-inventory", "args": "--subsidiaries" }, { "id": "cap-table-sync", "args": "--409a" }], "depends_on": [] }, 
      { "id": "insurance", "name": "Insurance Review", "mode": "sequential", "commands": [{ "id": "insurance-review", "args": "--d-and-o" }], "depends_on": [\"sync\"] }]
  }
}
