{
  "id": "revops-territory",
  "name": "Territory Planning",
  "description": "Territory pipeline",
  "trigger": "/revops:territory",
  "output_dir": "reports/revops/territory",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "segment", "name": "Segment Market", "mode": "sequential", "commands": [{"id": "segment-market", "args": "--geo,vertical"}], "depends_on": []},
      {"id": "assign", "name": "Assign Territories", "mode": "sequential", "commands": [{"id": "assign-territories", "args": "--balanced"}], "depends_on": ["segment"]},
      {"id": "quotas", "name": "Set Quotas", "mode": "sequential", "commands": [{"id": "set-quotas", "args": "--bottom-up"}], "depends_on": ["assign"]}
    ]
  }
}
