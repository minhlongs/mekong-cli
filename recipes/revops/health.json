{
  "id": "revops-health",
  "name": "Customer Health",
  "description": "Health score pipeline",
  "trigger": "/revops:health",
  "output_dir": "reports/revops/health",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "scores", "name": "CS + Sales + Usage Scores", "mode": "parallel", "commands": [{"id": "cs-score", "args": "--nps"}, {"id": "sales-score", "args": "--engagement"}, {"id": "usage-score", "args": "--dau-mau"}], "depends_on": []},
      {"id": "unified", "name": "Unified Health", "mode": "sequential", "commands": [{"id": "unified-health", "args": "--risk-tier"}], "depends_on": ["scores"]}
    ]
  }
}
