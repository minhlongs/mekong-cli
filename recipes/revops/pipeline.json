{
  "id": "revops-pipeline",
  "name": "Pipeline Visibility",
  "description": "Pipeline dashboard",
  "trigger": "/revops:pipeline",
  "output_dir": "reports/revops/pipeline",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "aggregate", "name": "Aggregate Stages", "mode": "sequential", "commands": [{"id": "aggregate-stages", "args": "--all-reps"}], "depends_on": []},
      {"id": "clean", "name": "Clean Data", "mode": "sequential", "commands": [{"id": "clean-data", "args": "--dedup"}], "depends_on": ["aggregate"]},
      {"id": "dashboard", "name": "Dashboard", "mode": "sequential", "commands": [{"id": "pipeline-dashboard", "args": "--realtime"}], "depends_on": ["clean"]}
    ]
  }
}
