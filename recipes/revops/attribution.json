{
  "id": "revops-attribution",
  "name": "Attribution Analysis",
  "description": "Attribution pipeline",
  "trigger": "/revops:attribution",
  "output_dir": "reports/revops/attribution",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "collect", "name": "Collect Touchpoints", "mode": "sequential", "commands": [{"id": "collect-touchpoints", "args": "--all-channels"}], "depends_on": []},
      {"id": "model", "name": "Model Attribution", "mode": "sequential", "commands": [{"id": "model-attribution", "args": "--multi-touch"}], "depends_on": ["collect"]},
      {"id": "roi", "name": "Calculate ROI", "mode": "sequential", "commands": [{"id": "calculate-roi", "args": "--per-channel"}], "depends_on": ["model"]}
    ]
  }
}
