{
  "id": "revops-comp",
  "name": "Commission Calc",
  "description": "Commission pipeline",
  "trigger": "/revops:comp",
  "output_dir": "reports/revops/comp",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "pull", "name": "Pull Bookings", "mode": "sequential", "commands": [{"id": "pull-bookings", "args": "--period"}], "depends_on": []},
      {"id": "apply", "name": "Apply Plan", "mode": "sequential", "commands": [{"id": "apply-plan", "args": "--current-fy"}], "depends_on": ["pull"]},
      {"id": "calc", "name": "Calculate Comp", "mode": "sequential", "commands": [{"id": "calculate-comp", "args": "--spifs"}], "depends_on": ["apply"]},
      {"id": "approve", "name": "Approve", "mode": "sequential", "commands": [{"id": "approve-comp", "args": "--finance-review"}], "depends_on": ["calc"]}
    ]
  }
}
