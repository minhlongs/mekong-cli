{
  "id": "revops-handoff",
  "name": "Lead Handoff",
  "description": "Handoff pipeline",
  "trigger": "/revops:handoff",
  "output_dir": "reports/revops/handoff",
  "estimated_credits": 2,
  "estimated_minutes": 5,
  "dag": {
    "groups": [
      {"id": "qualify", "name": "Qualify Lead", "mode": "sequential", "commands": [{"id": "qualify-lead", "args": "--scoring"}], "depends_on": []},
      {"id": "match", "name": "Match AE", "mode": "sequential", "commands": [{"id": "match-ae", "args": "--territory"}], "depends_on": ["qualify"]},
      {"id": "handoff", "name": "Handoff", "mode": "sequential", "commands": [{"id": "execute-handoff", "args": "--sla-24h"}], "depends_on": ["match"]},
      {"id": "track", "name": "Track SLA", "mode": "sequential", "commands": [{"id": "track-sla", "args": "--alert"}], "depends_on": ["handoff"]}
    ]
  }
}
