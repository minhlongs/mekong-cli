{
  "id": "revops-forecast",
  "name": "Revenue Forecast",
  "description": "Forecast pipeline",
  "trigger": "/revops:forecast",
  "output_dir": "reports/revops/forecast",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "pull", "name": "Pull Pipeline", "mode": "sequential", "commands": [{"id": "pull-pipeline", "args": "--crm"}], "depends_on": []},
      {"id": "weight", "name": "Weight Stages", "mode": "sequential", "commands": [{"id": "weight-stages", "args": "--historical"}], "depends_on": ["pull"]},
      {"id": "model", "name": "Model Scenarios", "mode": "sequential", "commands": [{"id": "model-scenarios", "args": "--bear,base,bull"}], "depends_on": ["weight"]},
      {"id": "report", "name": "Forecast Report", "mode": "sequential", "commands": [{"id": "forecast-report", "args": "--board-format"}], "depends_on": ["model"]}
    ]
  }
}
