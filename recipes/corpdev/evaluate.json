{
  "id": "corpdev-evaluate",
  "name": "Acquisition Eval",
  "description": "Acquisition evaluation",
  "trigger": "/corpdev:evaluate",
  "output_dir": "reports/corpdev/evaluate",
  "estimated_credits": 5,
  "estimated_minutes": 20,
  "dag": {
    "groups": [
      {"id": "assess", "name": "Financial + Team + Tech Assessment", "mode": "parallel", "commands": [{"id": "financial-model", "args": "--dcf"}, {"id": "team-assess", "args": "--key-people"}, {"id": "tech-assess", "args": "--stack-review"}], "depends_on": []},
      {"id": "rec", "name": "Recommendation", "mode": "sequential", "commands": [{"id": "acquisition-rec", "args": "--board-memo"}], "depends_on": ["assess"]}
    ]
  }
}
