{
  "id": "corpdev-synergy",
  "name": "Synergy Tracking",
  "description": "Synergy tracking",
  "trigger": "/corpdev:synergy",
  "output_dir": "reports/corpdev/synergy",
  "estimated_credits": 2,
  "estimated_minutes": 8,
  "dag": {
    "groups": [
      {"id": "identify", "name": "Identify Synergies", "mode": "sequential", "commands": [{"id": "identify-synergies", "args": "--revenue,cost"}], "depends_on": []},
      {"id": "track", "name": "Track Realization", "mode": "sequential", "commands": [{"id": "track-realization", "args": "--monthly"}], "depends_on": ["identify"]},
      {"id": "report", "name": "Synergy Report", "mode": "sequential", "commands": [{"id": "synergy-report", "args": "--board-format"}], "depends_on": ["track"]}
    ]
  }
}
