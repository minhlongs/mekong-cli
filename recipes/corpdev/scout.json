{
  "id": "corpdev-scout",
  "name": "M&A Scout",
  "description": "M&A target identification",
  "trigger": "/corpdev:scout",
  "output_dir": "reports/corpdev/scout",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": {
    "groups": [
      {"id": "criteria", "name": "Define Criteria", "mode": "sequential", "commands": [{"id": "define-criteria", "args": "--strategic-fit"}], "depends_on": []},
      {"id": "scan", "name": "Scan Market", "mode": "sequential", "commands": [{"id": "scan-market", "args": "--crunchbase,pitchbook"}], "depends_on": ["criteria"]},
      {"id": "shortlist", "name": "Shortlist", "mode": "sequential", "commands": [{"id": "shortlist-targets", "args": "--top-10"}], "depends_on": ["scan"]}
    ]
  }
}
