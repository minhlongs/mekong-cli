{
  "id": "terrain-position",
  "name": "Competitive Position",
  "description": "Positioning analysis",
  "trigger": "/terrain:position",
  "output_dir": "reports/terrain/position",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "map", "name": "Map Competitors", "mode": "sequential", "commands": [{"id": "map-competitors", "args": "--per-segment"}], "depends_on": []},
      {"id": "assess", "name": "Assess Position", "mode": "sequential", "commands": [{"id": "assess-position", "args": "--strengths,weaknesses"}], "depends_on": ["map"]},
      {"id": "recommend", "name": "Recommend Moves", "mode": "sequential", "commands": [{"id": "recommend-moves", "args": "--offensive,defensive"}], "depends_on": ["assess"]}] }
}
