{
  "id": "terrain-segment",
  "name": "Market Segmentation",
  "description": "Terrain-based segmentation",
  "trigger": "/terrain:segment",
  "output_dir": "reports/terrain/segment",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "identify", "name": "Identify Segments", "mode": "sequential", "commands": [{"id": "identify-segments", "args": "--tam,sam,som"}], "depends_on": []},
      {"id": "classify", "name": "Classify Terrain", "mode": "sequential", "commands": [{"id": "classify-terrain", "args": "--nine-types"}], "depends_on": ["identify"]},
      {"id": "strategy", "name": "Strategic Implications", "mode": "sequential", "commands": [{"id": "terrain-strategy", "args": "--per-segment"}], "depends_on": ["classify"]}] }
}
