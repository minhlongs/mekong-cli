{
  "id": "terrain-retreat",
  "name": "Strategic Retreat",
  "description": "Market exit strategy",
  "trigger": "/terrain:retreat",
  "output_dir": "reports/terrain/retreat",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "viability", "name": "Assess Viability", "mode": "sequential", "commands": [{"id": "assess-viability", "args": "--unit-economics"}], "depends_on": []},
      {"id": "triggers", "name": "Define Triggers", "mode": "sequential", "commands": [{"id": "define-triggers", "args": "--stop-loss-criteria"}], "depends_on": ["viability"]},
      {"id": "exit", "name": "Exit Plan", "mode": "sequential", "commands": [{"id": "exit-plan", "args": "--wind-down-timeline"}], "depends_on": ["triggers"]}] }
}
