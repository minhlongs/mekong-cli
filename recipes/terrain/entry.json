{
  "id": "terrain-entry",
  "name": "Market Entry",
  "description": "Market entry strategy",
  "trigger": "/terrain:entry",
  "output_dir": "reports/terrain/entry",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "assess", "name": "Assess Terrain", "mode": "sequential", "commands": [{"id": "assess-terrain", "args": "--barriers,timing"}], "depends_on": []},
      {"id": "mode", "name": "Choose Entry Mode", "mode": "sequential", "commands": [{"id": "choose-entry-mode", "args": "--direct,partner,acquire"}], "depends_on": ["assess"]},
      {"id": "plan", "name": "Execution Plan", "mode": "sequential", "commands": [{"id": "entry-execution-plan", "args": "--milestones"}], "depends_on": ["mode"]}] }
}
