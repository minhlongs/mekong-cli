{
  "id": "intel-blind-spot",
  "name": "Blind Spot Detection",
  "description": "Blind spot analysis",
  "trigger": "/intel:blind-spot",
  "output_dir": "reports/intel/blind-spot",
  "estimated_credits": 3,
  "estimated_minutes": 10,
  "dag": { "groups": [
      {"id": "map", "name": "Map Knowledge", "mode": "sequential", "commands": [{"id": "map-knowledge", "args": "--domain-coverage"}], "depends_on": []},
      {"id": "gaps", "name": "Identify Gaps", "mode": "sequential", "commands": [{"id": "identify-gaps", "args": "--critical-unknowns"}], "depends_on": ["map"]},
      {"id": "source", "name": "Source Intel", "mode": "sequential", "commands": [{"id": "source-intel", "args": "--external-signals"}], "depends_on": ["gaps"]}] }
}
