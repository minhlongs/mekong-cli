{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbook/mekong-cli/.codex/hooks/pre-tool-use-guard.cjs'",
            "timeout": 2000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbook/mekong-cli/.codex/hooks/post-edit-simplify-reminder.cjs'",
            "timeout": 1500
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbook/mekong-cli/.codex/hooks/pre-compact-state-saver.cjs'",
            "timeout": 1500
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbook/mekong-cli/.codex/hooks/session-init.cjs'",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbook/mekong-cli/.codex/hooks/dev-rules-reminder.cjs'",
            "timeout": 1500
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbook/mekong-cli/.codex/hooks/subagent-init.cjs'",
            "timeout": 2000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/macbook/mekong-cli/.codex/hooks/stop-checkpoint.cjs'",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
