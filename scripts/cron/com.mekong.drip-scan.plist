<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mekong.drip-scan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/macbook/mekong-cli/scripts/cron/vn_drip_scan.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/macbook/mekong-cli</string>
    <key>StandardOutPath</key>
    <string>/Users/macbook/mekong-cli/logs/drip-scan.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macbook/mekong-cli/logs/drip-scan.log</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>17</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MEKONG_PILOT_DIR</key>
        <string>/Users/macbook/.mekong</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
