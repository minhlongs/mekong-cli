/**
 * model-router-config.cjs — Model Routing Configuration
 *
 * DeepSeek V4 Flash/Pro routing. No China model entries — removed per user request.
 * ZuneF uses pure Opus-only mapping (4.8/4.7/4.6), not this router.
 *
 * @module model-router-config
 */
'use strict';

const TIERS = Object.freeze({
  FLASH: {
    name: 'flash', model: 'deepseek-v4-flash[1m]', role: 'Executor',
    defaultTier: true, costPerMTokens: 0.003,
    percentTarget: { min: 85, max: 95 }
  },
  PRO: {
    name: 'pro', model: 'deepseek-v4-pro[1m]', role: 'Architect',
    defaultTier: false, costPerMTokens: 0.14,
    percentTarget: { min: 5, max: 15 }
  }
});

const ESCALATION_SIGNALS = Object.freeze({
  exact: Object.freeze([
    { pattern: /system\s*design/i,            label: 'system-design' },
    { pattern: /architectur/i,                 label: 'architecture' },
    { pattern: /framework\s*migrat/i,          label: 'framework-migration' },
    { pattern: /migrate\s+(from|to)\s+\w+/i,   label: 'migration-explicit' },
    { pattern: /\bmigrat/i,                     label: 'migration-general' },
    { pattern: /refactor\s+(the\s+)?(entire|whole|all)\s/i, label: 'large-refactor' },
    { pattern: /trade\s*-?\s*off/i,            label: 'tradeoff-analysis' },
    { pattern: /evaluate\s+(pro|con|option|approach)/i, label: 'evaluation-request' },
    { pattern: /complexity\s+analysis/i,       label: 'complexity-analysis' },
  ]),
  strong: Object.freeze([
    { pattern: /multi\s*-?\s*file\s+(refactor|change|edit)/i, label: 'multi-file-refactor' },
    { pattern: /optimization\s+strateg/i,       label: 'optimization-strategy' },
    { pattern: /migration\s+plan/i,             label: 'migration-plan' },
    { pattern: /data\s+model/i,                 label: 'data-model-design' },
    { pattern: /schema\s+(design|change|migrat)/i, label: 'schema-change' },
    { pattern: /api\s+(design|architect)/i,     label: 'api-design' },
    { pattern: /performance\s+(optim|analyz|tun|bottleneck|improv)/i, label: 'performance-analysis' },
    { pattern: /security\s+(audit|review|analyz)/i, label: 'security-review' },
    { pattern: /database\s+(schema|migrat|design)/i, label: 'database-design' },
    { pattern: /(what|which)\s+(are\s+)?(the\s+)?(trade|pro|con|option|approach)/i, label: 'decision-analysis' },
    { pattern: /^why\s/i,                       label: 'why-question' },
  ]),
  pattern: Object.freeze([
    { pattern: /(rewrite|restructur|redesign|refactor)\s+(the\s+)?(entire|whole|core)/i, label: 'large-rewrite' },
    { pattern: /should\s+(i|we)\s+(use|choose|pick|adopt)/i, label: 'design-decision' },
    { pattern: /^why\s/i,                       label: 'why-question' },
    { pattern: /intermittent|race\s*condition|deadlock|memory\s*leak/i, label: 'complex-bug' },
    { pattern: /integrat(ion|e)\s+(with|between)\s+\w+/i, label: 'integration-work' },
    { pattern: /concurr(ency|ent)|parallelism|async\s+(flow|pattern)/i, label: 'concurrency' },
  ]),
  weak: Object.freeze([
    { pattern: /strategy/i, label: 'strategy-reference' },
  ]),
  failureBased: Object.freeze([
    { key: 'repeatedFlashFailures', label: 'repeated-execution-failures', weight: 10 },
    { key: 'unresolvedCompilationErrors', label: 'unresolved-compile-errors', weight: 10 },
    { key: 'repeatedTestFailures', label: 'repeated-test-failures', weight: 8 },
    { key: 'poorFlashConfidence', label: 'flash-confidence-below-threshold', weight: 7 },
  ]),
});

const THRESHOLDS = Object.freeze({
  escalationThreshold: 7, flashConfidenceFloor: 50,
  maxFlashRetries: 1, maxFilesForFlash: 5, maxFlashTokens: 8000,
});

const FLASH_CAPABLE_TASKS = Object.freeze([
  'Read a file', 'Search for code', 'Grep for a pattern',
  'Edit a single file', 'Create a file', 'Delete a file', 'Rename a file',
  'Write unit tests', 'Write documentation', 'Run a script',
  'Install dependencies', 'Fix a small bug', 'Format code', 'Add comments',
  'Generate boilerplate', 'Execute a predefined plan step', 'Run a command',
  'Check git status', 'Review a PR', 'Run linting', 'Type-check a file',
  'Build the project',
]);

const COST_LADDER = Object.freeze([
  { tier: 'flash', description: 'Flash (default)', cumulative: 'lowest' },
  { tier: 'flash-retry', description: 'Flash with retry', cumulative: 'low' },
  { tier: 'flash-context', description: 'Flash with more context', cumulative: 'medium' },
  { tier: 'pro', description: 'Escalate to Pro', cumulative: 'high' },
  { tier: 'flash-verify', description: 'Return to Flash after Pro plan', cumulative: 'medium-high' },
]);

module.exports = {
  TIERS, ESCALATION_SIGNALS, THRESHOLDS,
  FLASH_CAPABLE_TASKS, COST_LADDER,
};
