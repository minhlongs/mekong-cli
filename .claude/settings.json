    "padding": 0
  },
  "fastMode": true,
  "skipDangerousModePermissionPrompt": true,
  "llm": {
    "mode": "zunef",
    "zunef": {
      "apiKeyHelper": "node -e \"const fs=require('fs');const os=require('os');const path=require('path');const crypto=require('crypto');const devicePattern=/^[a-z0-9][a-z0-9._:-]{7,127}$/i;const claudeDir=path.join(os.homedir(),'.claude');const deviceFile=path.join(claudeDir,'zunef-device-id');let deviceId='';try{deviceId=String(fs.readFileSync(deviceFile,'utf8')||'').trim();}catch{}if(!devicePattern.test(deviceId)){deviceId=(typeof crypto.randomUUID==='function'?crypto.randomUUID():crypto.randomBytes(16).toString('hex')).replace(/-/g,'').toLowerCase();fs.mkdirSync(claudeDir,{recursive:true});fs.writeFileSync(deviceFile,deviceId,'utf8');}const u=new URL(\\\"https://claude.zunef.com/api/claude-code/us3VHCsPoSkayXB6iw4fFLEiKwUDJTrx/auth\\\");u.searchParams.set('deviceId',deviceId);fetch(u,{headers:{Accept:'text/plain','X-ZUNEF-CLIENT':'claude-code','X-Device-Id':deviceId}}).then(async(r)=>{const t=(await r.text()).trim();if(!r.ok||!t){throw new Error(t||('HTTP '+r.status));}process.stdout.write(t);}).catch((err)=>{console.error(String(err&&err.message||err));process.exit(1);})\"",
      "baseUrl": "https://claude-api.zunef.com/v1/ai",
