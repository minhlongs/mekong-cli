{
  "includeCoAuthoredBy": false,
  "outputStyle": "coding-level-3-senior",
  "cleanupPeriodDays": 30,
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "additionalDirectories": [
      "sops",
      "agents",
      "evals",
      "observability",
      "docs",
      "src/harness",
      "tests"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(npm test:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec:*)",
      "Bash(npm run lint:*)",
      "Bash(pnpm lint:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(bash .ci/*:*)",
      "Bash(python3 -m src.main cook:*)",
      "Bash(python3 -m src.main cook-auto:*)",
      "Bash(python3 -m src.main cook-auto-parallel:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/**/.env)",
      "Read(./apps/**/.env.*)",
      "Read(./mekong/daemon/**)",
      "Edit(./.git/**)",
      "Edit(./apps/**)",
      "Edit(./mekong/daemon/**)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/*:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-auto-merge-context.cjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-init.cjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/usage-quota-cache-refresh.cjs",
            "_origin": "engineer"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dev-rules-reminder.cjs",
            "timeout": 1500
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/simplify-gate.cjs",
            "_origin": "engineer"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/mekong/hooks/brainstorm-vn-inject.cjs"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/usage-quota-cache-refresh.cjs",
            "_origin": "engineer"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use-guard.cjs",
            "timeout": 2000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/plan-format-kanban.cjs",
            "_origin": "engineer"
          }
        ]
      },
      {
        "matcher": "Task|TaskCreate|TaskUpdate|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-state.cjs",
            "_origin": "engineer"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/usage-quota-cache-refresh.cjs",
            "_origin": "engineer"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/subagent-init.cjs",
            "timeout": 2000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cook-after-plan-reminder.cjs",
            "timeout": 1500
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-state.cjs",
            "_origin": "engineer"
          }
        ]
      }
    ]
  },
  "modelRouting": {
    "defaultProvider": "ollama",
    "providers": {
      "ollama": {
        "baseUrl": "http://localhost:11434/v1",
        "model": "qwen3:35b-cc",
        "apiKey": "ollama",
        "timeoutMs": 120000,
        "priority": 1
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "model": "x-ai/grok-code-fast",
        "timeoutMs": 60000,
        "priority": 2
      },
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "model": "gpt-4o",
        "timeoutMs": 60000,
        "priority": 3
      },
      "anthropic": {
        "baseUrl": "https://api.anthropic.com/v1",
        "model": "claude-sonnet-4-20250514",
        "timeoutMs": 60000,
        "priority": 4
      },
      "google": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemini-2.0-flash",
        "timeoutMs": 60000,
        "priority": 5
      },
      "dashscope": {
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "model": "qwen-turbo",
        "timeoutMs": 60000,
        "priority": 6
      },
      "offline": {
        "baseUrl": "file://offline",
        "model": "offline",
        "timeoutMs": 1000,
        "priority": 99
      }
    },
    "rules": [
      {
        "match": [
          "mk-cook",
          "mk-plan",
          "mk-debug",
          "mk-code",
          "cook",
          "plan",
          "code"
        ],
        "provider": "ollama",
        "model": "qwen3:35b-cc",
        "reason": "Code-heavy tasks use local Ollama for speed"
      },
      {
        "match": [
          "mk-binh-phap",
          "mk-strategy",
          "mk-cfo",
          "mk-cmo"
        ],
        "provider": "openrouter",
        "model": "x-ai/grok-code-fast",
        "reason": "Strategy tasks use Grok for reasoning"
      },
      {
        "match": [
          "mk-brainstorm",
          "mk-research",
          "mk-analyze"
        ],
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "reason": "Creative tasks use Claude"
      }
    ]
  },
  "env": {
    "LLM_BASE_URL": "http://localhost:11434/v1",
    "LLM_API_KEY": "ollama",
    "LLM_MODEL": "qwen3:35b-cc",
    "LLM_PROVIDER": "ollama",
    "LLM_TIMEOUT_MS": "120000",
    "MEKONG_ENV": "development",
    "LOG_LEVEL": "INFO"
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/macbook/mekong-cli"
      ],
      "enabled": true
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "/Users/macbook/mekong-cli"
      ],
      "enabled": true
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "/Users/macbook/mekong-cli/.mekong"
      ],
      "enabled": true
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": false
    }
  }
}
