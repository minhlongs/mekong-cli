{
  "name": "mekong-cli",
  "version": "6.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "RaaS Agency Operating System - Powered by Binh Phap & ClaudeKit DNA",
  "author": "Binh Phap Venture Studio",
  "license": "MIT",
  "homepage": "https://agencyos.network",
  "repository": {
    "type": "git",
    "url": "https://github.com/longtho638-jpg/mekong-cli.git"
  },
  "bugs": {
    "url": "https://github.com/longtho638-jpg/mekong-cli/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "!packages/cleo-new"
  ],
  "scripts": {
    "start": "npm run dev --workspace=apps/dashboard",
    "dev": "MEKONG_ENV=development npx turbo run dev",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "build": "npx turbo run build --concurrency=4",
    "build:prod": "MEKONG_ENV=production bun build ./ide-core/cli-ts/env.ts --compile --target=bun-darwin-arm64 --outfile mekong",
    "test": "npx turbo run test --concurrency=5",
    "lint": "npx turbo run lint --concurrency=1",
    "format": "npx turbo run format --concurrency=10",
    "type-check": "tsc --noEmit",
    "gws": "npx -y @googleworkspace/cli",
    "farm:start": "bash ide-core/engine-farm/start-farm.sh",
    "farm:start:dev": "MEKONG_ENV=development bash ide-core/engine-farm/start-farm.sh",
    "farm:start:prod": "MEKONG_ENV=production bash ide-core/engine-farm/start-farm.sh",
    "farm:stop": "bash ide-core/engine-farm/stop-farm.sh",
    "farm:migrate": "bash ide-core/engine-farm/migrate-models.sh",
    "farm:ab-test": "bash ide-core/engine-farm/ab-test.sh",
    "farm:cutover": "bash ide-core/engine-farm/cutover.sh --yes",
    "postinstall": "bash scripts/setup-dev.sh --quick 2>/dev/null || true",
    "start:api": "uvicorn src.gateway:app --host 0.0.0.0 --port 8000",
    "start:landing": "npx serve apps/landing -l 3001",
    "health": "bash scripts/health-check.sh",
    "idea:init": "bash scripts/idea-init.sh",
    "idea:smoke": "mekong idea run \"add a /hello command\" --max-iter 4 --dry-run -y"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@eslint/js": "^9.28.0",
    "@types/node": "25.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.18.0",
    "bun-types": "^1.3.14",
    "claudekit": "^0.7.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.24.2",
    "eslint": "9",
    "turbo": "^2.8.12",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "catalog": {
      "@types/express": "^5.0.0",
      "@types/jsonwebtoken": "^9.0.0",
      "@types/lodash": "^4.17.0",
      "@types/mime-types": "^2.1.0",
      "@types/uuid": "^10.0.0",
      "@types/xml2js": "^0.4.0",
      "@langchain/core": "^0.3.0",
      "@sentry/node": "^9.0.0",
      "@sentry/node-native": "^9.0.0",
      "@sentry/profiling-node": "^9.0.0",
      "axios": "^1.0.0",
      "callsites": "^4.0.0",
      "eslint": "9.28.0",
      "fast-glob": "^3.0.0",
      "form-data": "^4.0.0",
      "http-proxy-agent": "^7.0.0",
      "https-proxy-agent": "^7.0.0",
      "iconv-lite": "^0.6.0",
      "typescript": "^5.0.0"
    },
    "overrides": {
      "@types/react": "^19.2.14",
      "esbuild": "0.24.2",
      "undici@<6.23.0": ">=6.23.0",
      "path-to-regexp@>=4.0.0 <6.3.0": ">=6.3.0",
      "tmp@<=0.2.3": ">=0.2.4",
      "glob@>=11.0.0 <11.1.0": ">=11.1.0",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "next@>=15.6.0-canary.0 <16.1.5": ">=16.1.5",
      "fastify@<=5.7.2": ">=5.7.3",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "hono@<4.11.10": ">=4.11.10",
      "eslint>ajv": "6.12.6",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "bn.js@>=5.0.0 <5.2.3": ">=5.2.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "rollup@<2.80.0": ">=2.80.0",
      "basic-ftp@<5.2.0": ">=5.2.0",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "jsondiffpatch@<0.7.2": ">=0.7.2",
      "ai@<5.0.52": ">=5.0.52",
      "esbuild@<=0.24.0": "0.24.2",
      "devalue@<5.3.2": ">=5.3.2",
      "wrangler@>=2.0.15 <3.114.17": ">=3.114.17",
      "devalue@<=5.6.2": ">=5.6.3",
      "ajv@<6.14.0": ">=6.14.0",
      "dompurify@>=3.1.3 <=3.3.1": ">=3.3.2",
      "svgo@=4.0.0": ">=4.0.1",
      "fastify@>=5.7.2 <=5.8.0": ">=5.8.1",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "express-rate-limit@>=8.2.0 <8.2.2": ">=8.2.2",
      "tar@<=7.5.9": ">=7.5.10",
      "xlsx@<0.18.5": ">=0.18.5",
      "minimatch@^3.0.0 <3.1.10": ">=3.1.10",
      "minimatch@^9.0.0 <9.0.5": ">=9.0.5",
      "hono@<4.12.7": ">=4.12.7"
    }
  },
  "bin": {
    "mekong": "./bin/mekong"
  }
}
