    {
      "name": "Harness Engineering for Coding Agent Users",
      "url": "https://martinfowler.com/articles/harness-engineering.html",
      "principles": [
        "model plus harness",
        "feedforward controls",
        "feedback controls",
        "steering loop",
        "keep quality left"
      ]
    },
    {
      "name": "Hermes Agent Docs",
      "url": "https://hermes-agent.nousresearch.com/docs/",
      "principles": [
        "closed learning loop",
        "portable skills",
        "persistent memory",
        "MCP integration",
        "safe tool gateways"
      ]
    },
    {
      "name": "Binh Phap operating doctrine",
      "url": "HARNESS.md",
      "principles": [
        "calculate before acting",
        "win through strategy",
        "momentum through orchestration",
        "terrain-aware execution",
        "intelligence-led verification"
      ]
    }
  ],
