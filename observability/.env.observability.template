# Observability stack secrets — copy to .env.observability and fill in values
# NEVER commit .env.observability to git

# Grafana admin password (change before first run)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-before-first-run

# Optional: Grafana SMTP for alert emails (leave blank to disable)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
