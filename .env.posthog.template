# .env.posthog.template — PostHog self-host environment variables
# Copy to .env.posthog and fill in values. NEVER commit .env.posthog to git.
#
# Usage:
#   cp .env.posthog.template .env.posthog
#   docker compose -f docker-compose.posthog.yml --env-file .env.posthog up -d

# PostgreSQL password for PostHog internal DB
POSTHOG_DB_PASSWORD=changeme_strong_password

# ClickHouse password (PostHog backend analytics store)
POSTHOG_CLICKHOUSE_PASSWORD=changeme_clickhouse_password

# Django secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(50))"
POSTHOG_SECRET_KEY=changeme_generate_with_secrets_token_hex_50

# Public URL (CF Tunnel endpoint)
POSTHOG_SITE_URL=https://posthog.m1max.cashclaw.cc

# PostHog project API key (get from PostHog UI after first login)
# Store in macOS Keychain: security add-generic-password -s posthog-api-key -a mekong -w <key>
# Then load: export POSTHOG_API_KEY=$(security find-generic-password -s posthog-api-key -a mekong -w)
POSTHOG_API_KEY=phc_changeme

# Enable PostHog sink in Mekong CLI (set to 1 only after stack is confirmed running)
SIGNALS_POSTHOG_ENABLED=0
