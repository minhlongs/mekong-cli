{
  "name": "@mekong/harness-core",
  "version": "1.0.0",
  "description": "Shared harness runtime for Mekong (mk) and Agent Kit (ak) personas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mk": "bin/mk.js",
    "ak": "bin/ak.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "mekong",
    "harness",
    "claude-code",
    "agent-kit",
    "cli"
  ],
  "author": "OpenClaw",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0",
    "cli-table3": "^0.6.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}