{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource that scrapes mekongd + agent-forest /metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "bargauge", "name": "Bar gauge", "version": ""}
  ],
  "title": "Mekong-IDE Overview",
  "uid": "mekong-ide-overview",
  "description": "Routing, cost, signals and queue health for mekongd + agent-forest. Drop-in dashboard — see docs/observability-mekong-ide.md.",
  "tags": ["mekong", "ide", "pillar-2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Local routing ratio",
      "description": "Share of /v1/messages routed to local Qwen (vs cloud). Target ≥ 0.6; alert if < 0.4 for 15m.",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "mekongd_local_ratio",
          "refId": "A",
          "legendFormat": "local ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.4},
              {"color": "green", "value": 0.6}
            ]
          }
        }
      },
      "options": {"showThresholdLabels": false, "showThresholdMarkers": true}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cloud spend today (UTC)",
      "description": "Sum of cost_usd for cloud-routed requests since UTC midnight. Configured cap shown as reference.",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "mekongd_cloud_spent_usd_today", "refId": "A", "legendFormat": "spent"},
        {"expr": "mekongd_cloud_daily_budget_usd", "refId": "B", "legendFormat": "budget"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 5},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "value_and_name"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Signals ratio (all)",
      "description": "Good share of every operator signal (auto + user). 0 when no signals.",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "mekongd_signals_ratio", "refId": "A", "legendFormat": "ratio"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.6},
              {"color": "green", "value": 0.8}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "User feedback ratio",
      "description": "Good share of user-forwarded signals only (note LIKE '%#user%'). Moves independently of auto stream.",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "mekongd_user_feedback_ratio", "refId": "A", "legendFormat": "user ratio"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.7},
              {"color": "green", "value": 0.85}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Requests/min by destination",
      "description": "1-minute rate split local vs cloud.",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (destination) (rate(mekongd_requests_total[1m]))",
          "refId": "A",
          "legendFormat": "{{destination}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      },
      "options": {"orientation": "horizontal", "displayMode": "gradient"}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "USD saved over time",
      "description": "Estimated USD saved by local routing (counter increase).",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "increase(mekongd_cost_saved_usd_total[5m])",
          "refId": "A",
          "legendFormat": "saved/5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {"drawStyle": "line", "fillOpacity": 20, "lineWidth": 2}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token throughput",
      "description": "Input vs output tokens per second.",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "rate(mekongd_tokens_in_total[1m])", "refId": "A", "legendFormat": "tokens in/s"},
        {"expr": "rate(mekongd_tokens_out_total[1m])", "refId": "B", "legendFormat": "tokens out/s"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue depth (agent-forest)",
      "description": "LLEN TASK_QUEUE. Alert if > 50 for 5m (producer outrunning workers).",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "agent_forest_queue_depth", "refId": "A", "legendFormat": "queue depth"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 25},
              {"color": "red", "value": 50}
            ]
          },
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": {"mode": "line"}}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Workers alive",
      "description": "agent-forest workers with heartbeat TTL < 60s. Zero with pending queue = dead pool.",
      "gridPos": {"x": 0, "y": 18, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "agent_forest_workers_alive", "refId": "A", "legendFormat": "alive"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 1},
              {"color": "green", "value": 2}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Heartbeat staleness",
      "description": "Seconds since most recent worker heartbeat. Climbing = workers degrading.",
      "gridPos": {"x": 8, "y": 18, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "time() - agent_forest_worker_last_seen_timestamp",
          "refId": "A",
          "legendFormat": "staleness"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 30},
              {"color": "red", "value": 60}
            ]
          }
        }
      },
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Liveness",
      "description": "agent-forest self-reported liveness gauge (1 = up).",
      "gridPos": {"x": 16, "y": 18, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "agent_forest_up", "refId": "A", "legendFormat": "up"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {"colorMode": "background"}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "prompt_guard rejections/s (agent-forest)",
      "description": "POST /task rejections by prompt_guard. Alert AgentForestPromptGuardSurge fires > 0.1/s for 5m (probe or false-positive regex).",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum by (reason) (rate(agent_forest_prompt_guard_rejections_total[5m]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 0.1},
              {"color": "red", "value": 1.0}
            ]
          },
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "thresholdsStyle": {"mode": "line"}}
        }
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}
