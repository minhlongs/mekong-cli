name: Deploy Mekong IDE (Dashboard Demo)
on:
  push:
    branches: [main, staging]
    paths: ['apps/dashboard/**']

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install dependencies
        working-directory: apps/dashboard
        run: npm install

      - name: Typecheck Dashboard Demo
        working-directory: apps/dashboard
        run: npm run typecheck

      - name: Build with vinext for Cloudflare Workers
        working-directory: apps/dashboard
        env:
          NEXT_PUBLIC_DEMO_MODE: 'true'
          DASHBOARD_DEMO_ONLY: 'true'
          NEXT_PUBLIC_API_URL: 'https://api.cashclaw.cc'
        run: npm run build:worker

      - name: Deploy to Cloudflare Workers (ide.mekongmind.com)
        working-directory: apps/dashboard
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN || secrets.CF_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CF_ACCOUNT_ID }}
        run: |
          if [ "${{ github.ref }}" = "refs/heads/main" ]; then
            npx wrangler deploy
          else
            npx wrangler deploy --env staging
          fi
