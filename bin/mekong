#!/usr/bin/env bash
# Mekong AI OS CLI wrapper
# Delegates to Python CLI (src/cli/) or TS CLI when compiled

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Check if compiled TS CLI exists
if [ -f "$SCRIPT_DIR/packages/mekong-cli-core/dist/cli.js" ]; then
  exec node "$SCRIPT_DIR/packages/mekong-cli-core/dist/cli.js" "$@"
fi

# Fall back to Python CLI
if [ -f "$SCRIPT_DIR/src/cli/start_command.py" ]; then
  exec python3 -m src.cli.start_command "$@"
fi

echo "Error: No CLI entry point found."
echo "Run: cd $(dirname $0)/.. && npm run dev"
exit 1
