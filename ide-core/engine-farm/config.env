# Mekong IDE Engine Farm — Ollama Model Configuration
# Source this file before starting Ollama servers
# Ollama 0.19+ uses Apple MLX natively on Apple Silicon

# --- Environment Mode ---
# development: Full-power models for internal team
# production: Lightweight models for B2B customer delivery
MEKONG_ENV="${MEKONG_ENV:-development}"

# --- Development Models (M1 Max 64GB) ---
DEV_ROUTER_MODEL="qwen2.5-coder:32b"
DEV_REASONING_MODEL="deepseek-r1:32b"
DEV_AUDIT_MODEL="qwen2.5-coder:7b"

# --- Production Models (customer machines, 16-32GB RAM) ---
PROD_ROUTER_MODEL="qwen2.5:14b"
PROD_REASONING_MODEL="nemotron:12b"
PROD_AUDIT_MODEL="qwen2.5:7b"

# --- Shared ---
OLLAMA_HOST="127.0.0.1"
OLLAMA_PORT=11434
OLLAMA_API="http://${OLLAMA_HOST}:${OLLAMA_PORT}"
