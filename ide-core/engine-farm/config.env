# Mekong IDE Engine Farm — Rapid-MLX Model Configuration
# Source this file before starting Rapid-MLX servers
# Rapid-MLX uses Apple MLX natively on Apple Silicon — 4.2x faster than Ollama

# --- Environment Mode ---
# development: Full-power models for internal team
# production: Lightweight models for B2B customer delivery
MEKONG_ENV="${MEKONG_ENV:-development}"

# --- Development Models (M1 Max 64GB — Qwen 3.6-35B primary) ---
DEV_ROUTER_MODEL="qwen3.6-35b"
DEV_REASONING_MODEL="qwen3.6-35b"
DEV_TOOL_MODEL="qwen3.5-4b"
DEV_TRADING_MODEL="phi4-mini-reasoning"
DEV_EMBED_MODEL="nomic-embed-text"

# --- Production Models (customer machines, 16-32GB RAM) ---
PROD_ROUTER_MODEL="qwen3.6-35b"
PROD_REASONING_MODEL="qwen3.6-35b"
PROD_TOOL_MODEL="qwen3.5-4b"
PROD_TRADING_MODEL="phi4-mini-reasoning"
PROD_EMBED_MODEL="nomic-embed-text"

# --- Shared ---
RAPID_MLX_HOST="127.0.0.1"
RAPID_MLX_PORT=8001
RAPID_MLX_API="http://${RAPID_MLX_HOST}:${RAPID_MLX_PORT}"

# Legacy Ollama compat
OLLAMA_HOST="127.0.0.1"
OLLAMA_PORT=11434
OLLAMA_API="http://${OLLAMA_HOST}:${OLLAMA_PORT}"
