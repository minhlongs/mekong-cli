# Mekong Engine Farm — Configuration
# Ports must NOT conflict with CashClaw (11435, 11436)

FARM_HOST="127.0.0.1"
PID_DIR="/tmp/mekong-farm-pids"
mkdir -p "$PID_DIR" 2>/dev/null || true

# ── Router: Gemma 4 27B A4B ──
ROUTER_MODEL="mlx-community/gemma-3-27b-it-qat-4bit"
ROUTER_PORT="${ROUTER_PORT:-4001}"
ROUTER_MAX_TOKENS=2048
ROUTER_CONTEXT=8192

# ── Reasoning: DeepSeek R1 32B ──
# Override with REASONING_PORT=11435 to share CashClaw's instance
REASONING_MODEL="mlx-community/DeepSeek-R1-Distill-Qwen-32B-4bit"
REASONING_PORT="${REASONING_PORT:-4002}"
REASONING_MAX_TOKENS=4096
REASONING_CONTEXT=8192

# ── Audit: Qwen2.5-Coder 7B ──
AUDIT_MODEL="mlx-community/Qwen2.5-Coder-7B-Instruct-4bit"
AUDIT_PORT="${AUDIT_PORT:-4003}"
AUDIT_MAX_TOKENS=2048
AUDIT_CONTEXT=4096
