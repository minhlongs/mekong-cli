# Mekong IDE Engine Farm — Ollama Model Configuration
# Source this file before starting Ollama servers
# Ollama 0.19+ uses Apple MLX natively on Apple Silicon

# --- Environment Mode ---
# development: Full-power models for internal team
# production: Lightweight models for B2B customer delivery
MEKONG_ENV="${MEKONG_ENV:-development}"

# --- Development Models (M1 Max 64GB — ~38.7GB total, 100/100) ---
DEV_ROUTER_MODEL="qwen3:30b-a3b"
DEV_REASONING_MODEL="deepseek-r1:32b"
DEV_TOOL_MODEL="qwen3:1.7b"
DEV_TRADING_MODEL="phi4-mini-reasoning"
DEV_EMBED_MODEL="nomic-embed-text"

# --- Production Models (customer machines, 16-32GB RAM — ~14.7GB) ---
PROD_ROUTER_MODEL="qwen2.5-coder:7b"
PROD_REASONING_MODEL="qwen3:8b"
PROD_TOOL_MODEL="qwen3:1.7b"
PROD_TRADING_MODEL="phi4-mini-reasoning"
PROD_EMBED_MODEL="nomic-embed-text"

# --- Shared ---
OLLAMA_HOST="127.0.0.1"
OLLAMA_PORT=11434
OLLAMA_API="http://${OLLAMA_HOST}:${OLLAMA_PORT}"
