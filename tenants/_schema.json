{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "slug", "tagline", "description", "featured_departments", "featured_commands", "branding"],
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "tagline": { "type": "string" },
    "description": { "type": "string" },
    "featured_departments": { "type": "array", "items": { "type": "string" } },
    "featured_commands": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "branding": {
      "type": "object",
      "required": ["accent_color", "icon"],
      "properties": {
        "accent_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "icon": { "type": "string" }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_credits_per_mission": { "type": "integer", "default": 5 },
        "default_model": { "type": "string", "default": "auto" }
      }
    },
    "polar_checkout_url": { "type": ["string", "null"] },
    "target_audience": { "type": "string" },
    "use_cases": { "type": "array", "items": { "type": "string" }, "maxItems": 5 }
  }
}
